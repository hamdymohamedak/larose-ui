{
  "name": "larose",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "eslint packages/*/src apps/*/src --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "doctor": "node packages/cli/dist/cli.js doctor",
    "check-budgets": "node scripts/check-budgets.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "migrate": "node packages/cli/dist/cli.js migrate --to 1.0.0",
    "migrate:apply": "node packages/cli/dist/cli.js migrate --to 1.0.0 --apply",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:publish": "pnpm build && changeset publish",
    "verify:publish": "node scripts/verify-publish.mjs",
    "sync:publish-metadata": "node scripts/sync-publish-metadata.mjs",
    "demo": "pnpm --filter @larose/demo dev",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@larose/accessibility": "workspace:*",
    "@larose/cli": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.16.0",
    "typescript-eslint": "^8.18.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/larose-ui/larose.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
