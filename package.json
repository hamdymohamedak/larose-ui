{
  "name": "larose",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @larose-ui/playground dev",
    "test": "turbo run test",
    "lint": "eslint packages/*/src apps/*/src --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "doctor": "node packages/cli/dist/cli.js doctor",
    "doctor:ci": "node packages/cli/dist/cli.js doctor --ci",
    "doctor:json": "node packages/cli/dist/cli.js doctor --ci --json",
    "release:report": "node packages/cli/dist/cli.js release",
    "visual-regression": "node scripts/visual-regression.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "migrate": "node packages/cli/dist/cli.js migrate --to 1.0.0",
    "migrate:apply": "node packages/cli/dist/cli.js migrate --to 1.0.0 --apply",
    "contribute": "node packages/cli/dist/cli.js contribute",
    "contribute:list": "node packages/cli/dist/cli.js contribute list",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:publish": "pnpm build && changeset publish",
    "verify:publish": "node scripts/verify-publish.mjs",
    "sync:publish-metadata": "node scripts/sync-publish-metadata.mjs",
    "generate:readmes": "node scripts/generate-package-readmes.mjs",
    "generate:contracts": "node scripts/generate-component-contracts.mjs",
    "generate:cross-framework-manifest": "node scripts/generate-cross-framework-manifest.mjs",
    "generate:storybook-parity": "node scripts/generate-storybook-parity.mjs && node scripts/generate-cross-framework-manifest.mjs",
    "check:framework-neutrality": "node scripts/check-framework-neutrality.mjs",
    "check:storybook-coverage": "node scripts/check-storybook-coverage.mjs",
    "demo": "pnpm --filter @larose-ui/demo dev",
    "webdocs": "pnpm --filter @larose-ui/docs dev",
    "webdocs:build": "pnpm --filter @larose-ui/docs build",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@larose-ui/accessibility": "workspace:*",
    "@larose-ui/cli": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hamdymohamedak/larose-ui.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
