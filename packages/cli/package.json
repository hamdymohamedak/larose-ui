{
  "name": "@larose-ui/cli",
  "version": "0.1.2",
  "description": "CLI for laRose UI platform — doctor, migrate, generate",
  "type": "module",
  "bin": {
    "larose": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup src/cli.ts --format esm --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@larose-ui/accessibility": "workspace:*",
    "@larose-ui/contracts": "workspace:*",
    "@larose-ui/migration": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamdymohamedak/larose-ui.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "larose",
    "react",
    "ui-platform",
    "design-system",
    "saas"
  ],
  "homepage": "https://github.com/hamdymohamedak/larose-ui/blob/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/hamdymohamedak/larose-ui/issues"
  }
}
