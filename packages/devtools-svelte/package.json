{
  "name": "@larose-ui/devtools-svelte",
  "version": "0.3.1",
  "description": "In-app runtime inspector for Svelte (development only).",
  "type": "module",
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@larose-ui/devtools-core": "workspace:*",
    "@larose-ui/runtime-svelte": "workspace:*",
    "@larose-ui/permissions-svelte": "workspace:*",
    "@larose-ui/observability-svelte": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "jsdom": "^25.0.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamdymohamedak/larose-ui.git",
    "directory": "packages/devtools-svelte"
  },
  "homepage": "https://github.com/hamdymohamedak/larose-ui/blob/main/packages/devtools-svelte#readme",
  "bugs": {
    "url": "https://github.com/hamdymohamedak/larose-ui/issues"
  },
  "larose": {
    "publicApi": true,
    "layer": "feature"
  },
  "keywords": [
    "larose",
    "larose-ui",
    "ui-platform",
    "design-system",
    "saas",
    "larose-public"
  ]
}
