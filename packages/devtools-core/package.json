{
  "name": "@larose-ui/devtools-core",
  "version": "0.3.1",
  "description": "[Internal] Framework-agnostic component performance helpers. Prefer @larose-ui/react, @larose-ui/vue, @larose-ui/svelte, or @larose-ui/runtime-* in apps.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@larose-ui/observability-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamdymohamedak/larose-ui.git",
    "directory": "packages/devtools-core"
  },
  "keywords": [
    "larose",
    "ui-platform",
    "devtools",
    "larose-internal"
  ],
  "homepage": "https://github.com/hamdymohamedak/larose-ui/blob/main/packages/devtools-core#readme",
  "bugs": {
    "url": "https://github.com/hamdymohamedak/larose-ui/issues"
  },
  "larose": {
    "publicApi": false,
    "layer": "internal"
  }
}
