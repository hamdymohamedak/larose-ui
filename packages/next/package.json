{
  "name": "@larose-ui/next",
  "version": "0.1.1",
  "description": "Next.js integration helpers for laRose UI — SSR, providers, and theme bootstrap",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@larose-ui/react": "workspace:*",
    "@larose-ui/runtime": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamdymohamedak/larose-ui.git",
    "directory": "packages/next"
  },
  "keywords": [
    "larose",
    "nextjs",
    "react",
    "ui-platform",
    "ssr"
  ],
  "homepage": "https://github.com/hamdymohamedak/larose-ui/blob/main/packages/next#readme",
  "bugs": {
    "url": "https://github.com/hamdymohamedak/larose-ui/issues"
  }
}
