{
  "name": "@larose-ui/runtime-svelte",
  "version": "0.2.0",
  "description": "Svelte 5 runtime adapter — LaRoseProvider (theme, toast, accelerator, network, offline, i18n) over runtime-core",
  "type": "module",
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "svelte": "./dist/toast/index.js",
      "import": "./dist/toast/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@larose-ui/core": "workspace:*",
    "@larose-ui/runtime-core": "workspace:*",
    "@larose-ui/network": "workspace:*",
    "@larose-ui/offline": "workspace:*",
    "@larose-ui/themes": "workspace:*",
    "@larose-ui/tokens": "workspace:*",
    "@larose-ui/permissions-svelte": "workspace:*",
    "@larose-ui/observability-svelte": "workspace:*"
  },
  "peerDependencies": {
    "@larose-ui/svelte": ">=0.2.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@larose-ui/svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@larose-ui/svelte": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "jsdom": "^25.0.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamdymohamedak/larose-ui.git",
    "directory": "packages/runtime-svelte"
  }
}
