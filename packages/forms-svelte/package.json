{
  "name": "@larose-ui/forms-svelte",
  "version": "0.2.0",
  "description": "Svelte 5 schema-driven forms adapter for laRose UI",
  "type": "module",
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@larose-ui/core": "workspace:*",
    "@larose-ui/data-core": "workspace:*",
    "@larose-ui/forms-core": "workspace:*",
    "@larose-ui/observability-svelte": "workspace:*",
    "@larose-ui/svelte": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "^5.2.6",
    "jsdom": "^25.0.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamdymohamedak/larose-ui.git",
    "directory": "packages/forms-svelte"
  },
  "keywords": ["larose", "svelte", "forms"],
  "homepage": "https://github.com/hamdymohamedak/larose-ui/blob/main/packages/forms-svelte#readme",
  "bugs": { "url": "https://github.com/hamdymohamedak/larose-ui/issues" }
}
