{
  "name": "@larose-ui/liquid-glass-core",
  "version": "0.2.0",
  "description": "Framework-agnostic Liquid Glass optics engine for laRose UI",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamdymohamedak/larose-ui.git",
    "directory": "packages/liquid-glass-core"
  },
  "keywords": [
    "larose",
    "liquid-glass",
    "ui-platform",
    "design-system"
  ],
  "homepage": "https://github.com/hamdymohamedak/larose-ui/blob/main/packages/liquid-glass-core#readme",
  "bugs": {
    "url": "https://github.com/hamdymohamedak/larose-ui/issues"
  }
}
