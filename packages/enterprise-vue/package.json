  "dependencies": {
    "@larose-ui/core": "workspace:*",
    "@larose-ui/enterprise-core": "workspace:*",
    "@larose-ui/forms-vue": "workspace:*",
    "@larose-ui/observability-vue": "workspace:*",
    "@larose-ui/permissions-vue": "workspace:*",
    "@larose-ui/runtime-vue": "workspace:*",
    "@larose-ui/vue": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
