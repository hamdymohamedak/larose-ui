{
  "name": "@larose-ui/enterprise-vue",
  "version": "0.3.0",
  "description": "Vue 3 enterprise adapter — audit, schema, session, version over enterprise-core",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
