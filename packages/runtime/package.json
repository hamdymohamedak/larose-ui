{
  "name": "@larose-ui/runtime",
  "version": "1.0.0",
  "description": "Runtime providers for laRose UI platform — theme, i18n, network, offline, responsive",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "import": "./dist/toast/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@larose-ui/core": "workspace:*",
    "@larose-ui/network": "workspace:*",
    "@larose-ui/offline": "workspace:*",
    "@larose-ui/permissions": "workspace:*",
    "@larose-ui/observability": "workspace:*",
    "@larose-ui/runtime-core": "workspace:*",
    "@larose-ui/themes": "workspace:*",
    "@larose-ui/tokens": "workspace:*"
  },
  "peerDependencies": {
    "@larose-ui/react": ">=0.2.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@larose-ui/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@larose-ui/react": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamdymohamedak/larose-ui.git",
    "directory": "packages/runtime"
  },
  "keywords": [
    "larose",
    "react",
    "ui-platform",
    "design-system",
    "saas"
  ],
  "homepage": "https://github.com/hamdymohamedak/larose-ui/blob/main/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/hamdymohamedak/larose-ui/issues"
  }
}
