{
  "name": "@larose/runtime",
  "version": "0.1.0",
  "description": "Runtime providers for laRose UI platform — theme, i18n, network, offline, responsive",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@larose/core": "workspace:*",
    "@larose/network": "workspace:*",
    "@larose/offline": "workspace:*",
    "@larose/permissions": "workspace:*",
    "@larose/observability": "workspace:*",
    "@larose/react": "workspace:*",
    "@larose/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/larose-ui/larose.git",
    "directory": "packages/runtime"
  },
  "keywords": [
    "larose",
    "react",
    "ui-platform",
    "design-system",
    "saas"
  ]
}
