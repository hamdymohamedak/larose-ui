    },
    {
      "id": "Closed",
      "title": "Closed",
      "kind": "advanced",
      "props": {
        "open": false
      },
      "code": "import { CommandPalette } from '@larose-ui/react';\n\n<CommandPalette\n  open={false}\n>Example</CommandPalette>"
    }
  ],
  "accessibility": [
    "Supports ARIA attributes via standard HTML element props.",
    "Focus is managed while open; Escape typically closes the overlay."
