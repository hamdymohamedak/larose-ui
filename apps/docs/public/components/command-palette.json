      "type": "CommandPaletteItem[]",
      "required": true,
      "inherited": false,
      "example": "—"
    },
    {
      "name": "onOpenChange",
      "type": "(open: boolean) => void",
      "required": true,
      "inherited": false,
      "example": "—"
    },
    {
      "name": "open",
      "type": "boolean",
      "required": true,
      "inherited": false,
      "example": "true"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "default": "'Search commands…'",
      "inherited": false,
      "example": "'Search commands…'"
    }
  ],
  "examples": [
    {
      "id": "CommandPaletteDefault",
      "title": "Command Palette Default",
      "kind": "basic",
      "props": {
        "open": true
      },
      "code": "import { AppShell } from '@larose-ui/react';\n\n<AppShell\n  open\n>Example</AppShell>"
    },
    {
      "id": "Playground",
      "title": "Playground",
      "kind": "advanced",
      "props": {},
      "code": "// See Storybook story \"Playground\" for full example.",
