{
  "component": "CommandPalette",
  "category": "Overlay",
  "package": "@larose-ui/react",
  "import": "import { CommandPalette } from '@larose-ui/react';",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false,
      "inherited": false,
      "example": "\"example\""
