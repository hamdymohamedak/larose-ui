; DNS for AI Discovery (DNS-AID) for hamdymohamedak.github.io
; Publish on a DNSSEC-signed zone you control (custom domain).
; github.io project sites cannot publish _agents under github.io — use a custom domain.
; See: https://datatracker.ietf.org/doc/draft-mozleywilliams-dnsop-dnsaid/

; Primary discovery index (SVCB ServiceMode)
_index._agents.hamdymohamedak.github.io. 3600 IN SVCB 1 hamdymohamedak.github.io. (
  alpn="h3,h2"
  port=443
  mandatory=alpn,port
  key65328="https://hamdymohamedak.github.io/larose-ui/.well-known/api-catalog"
)

; HTTPS alternate for HTTPS endpoints
_index._agents.hamdymohamedak.github.io. 3600 IN HTTPS 1 hamdymohamedak.github.io. (
  alpn="h3,h2"
  port=443
  mandatory=alpn,port
  key65328="https://hamdymohamedak.github.io/larose-ui/.well-known/api-catalog"
)

; Agent-to-agent / content map
_a2a._agents.hamdymohamedak.github.io. 3600 IN SVCB 1 hamdymohamedak.github.io. (
  alpn="h3,h2"
  port=443
  mandatory=alpn,port
  key65328="https://hamdymohamedak.github.io/larose-ui/llms.txt"
)

; ARD / AI Catalog discovery
_catalog._agents.hamdymohamedak.github.io. 3600 IN TXT "url=https://hamdymohamedak.github.io/larose-ui/.well-known/ai-catalog.json"

; MCP server card
_mcp._agents.hamdymohamedak.github.io. 3600 IN TXT "url=https://hamdymohamedak.github.io/larose-ui/.well-known/mcp/server-card.json"
