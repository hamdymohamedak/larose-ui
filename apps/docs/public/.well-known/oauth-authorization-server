{
  "resource": "https://hamdymohamedak.github.io/larose-ui/",
  "resource_name": "laRose UI Documentation API",
  "authorization_servers": [
    "https://hamdymohamedak.github.io/larose-ui"
  ],
  "scopes_supported": [
    "docs:read",
    "openid",
    "profile",
    "email"
  ],
  "bearer_methods_supported": [
    "header"
  ],
  "resource_documentation": "https://hamdymohamedak.github.io/larose-ui/docs/getting-started",
  "issuer": "https://hamdymohamedak.github.io/larose-ui",
  "authorization_endpoint": "https://hamdymohamedak.github.io/larose-ui/oauth/authorize",
  "token_endpoint": "https://hamdymohamedak.github.io/larose-ui/oauth/token",
  "jwks_uri": "https://hamdymohamedak.github.io/larose-ui/.well-known/jwks.json",
  "registration_endpoint": "https://hamdymohamedak.github.io/larose-ui/.well-known/oauth/register",
  "response_types_supported": [
    "code"
  ],
  "grant_types_supported": [
    "authorization_code",
    "client_credentials",
    "urn:ietf:params:oauth:grant-type:jwt-bearer"
  ],
  "token_endpoint_auth_methods_supported": [
    "client_secret_basic",
    "client_secret_post",
    "none"
  ],
  "code_challenge_methods_supported": [
    "S256"
  ],
  "revocation_endpoint": "https://hamdymohamedak.github.io/larose-ui/oauth/revoke",
  "agent_auth": {
    "skill": "https://hamdymohamedak.github.io/larose-ui/auth.md",
    "register_uri": "https://hamdymohamedak.github.io/larose-ui/.well-known/oauth/register",
    "identity_endpoint": "https://hamdymohamedak.github.io/larose-ui/agent/identity",
    "claim_uri": "https://hamdymohamedak.github.io/larose-ui/agent/identity/claim",
    "revocation_uri": "https://hamdymohamedak.github.io/larose-ui/oauth/revoke",
    "identity_types_supported": [
      "anonymous",
      "identity_assertion"
    ],
    "identity_assertion": {
      "assertion_types_supported": [
        "urn:ietf:params:oauth:token-type:id-jag"
      ]
    },
    "anonymous": {
      "credential_types_supported": [
        "access_token"
      ],
      "claim_uri": "https://hamdymohamedak.github.io/larose-ui/agent/identity/claim"
    },
    "events_supported": [
      "https://schemas.workos.com/events/agent/auth/identity/assertion/revoked"
    ]
  }
}
