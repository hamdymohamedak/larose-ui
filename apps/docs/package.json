{
  "name": "@larose-ui/docs",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pregenerate": "node ../../scripts/generate-docs-catalog.mjs",
    "predev": "pnpm run pregenerate && turbo run build --filter=@larose-ui/docs^...",
    "dev": "vite",
    "prebuild": "pnpm run pregenerate && turbo run build --filter=@larose-ui/docs^...",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@larose-ui/core": "workspace:*",
    "@larose-ui/react": "workspace:*",
    "@larose-ui/runtime-react": "workspace:*",
    "@larose-ui/styles": "workspace:*",
    "@larose-ui/svelte": "workspace:^",
    "@larose-ui/themes": "workspace:*",
    "@larose-ui/tokens": "workspace:*",
    "@larose-ui/vue": "workspace:^",
    "@mdx-js/react": "^3.1.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@vue/compiler-sfc": "^3.5.13",
    "lucide-react": "^1.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^7.1.1",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.0",
    "sucrase": "^3.35.1",
    "svelte": "^5.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.0",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
