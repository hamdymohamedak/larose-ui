{
  "name": "@larose-ui/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "turbo run build --filter=@larose-ui/playground^... && rm -rf node_modules/.cache/storybook",
    "dev": "storybook dev -p 6006",
    "prebuild": "turbo run build --filter=@larose-ui/playground^...",
    "build": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf storybook-static"
  },
  "dependencies": {
    "@larose-ui/core": "workspace:*",
    "@larose-ui/data-react": "workspace:*",
    "@larose-ui/forms-react": "workspace:*",
    "@larose-ui/observability-react": "workspace:*",
    "@larose-ui/permissions-react": "workspace:*",
    "@larose-ui/ai-react": "workspace:*",
    "@larose-ui/devtools-react": "workspace:*",
    "@larose-ui/enterprise-react": "workspace:*",
    "@larose-ui/react": "workspace:*",
    "@larose-ui/runtime-react": "workspace:*",
    "@larose-ui/styles": "workspace:*",
    "@larose-ui/tokens": "workspace:*",
    "@larose-ui/vue": "workspace:*",
    "@larose-ui/svelte": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vue": "^3.5.13",
    "svelte": "^5.19.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/core-events": "^8.4.7",
    "@storybook/manager-api": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "storybook": "^8.4.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
