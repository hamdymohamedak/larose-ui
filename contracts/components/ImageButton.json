{
  "name": "ImageButton",
  "version": "1",
  "framework": "neutral",
  "purpose": "ImageButton component — see composition and states for behavior.",
  "props": [
    {
      "name": "alt",
      "type": "string",
      "required": true
    },
    {
      "name": "imageProps",
      "type": "Omit<ImgHTMLAttributes<HTMLImageElement>, 'src' | 'alt'>",
      "required": false
    },
    {
      "name": "src",
      "type": "string",
      "required": true
    }
  ],
  "events": [],
  "states": [
    "default"
  ],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
