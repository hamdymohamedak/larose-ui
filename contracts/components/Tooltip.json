{
  "name": "Tooltip",
  "version": "1",
  "framework": "neutral",
  "purpose": "Tooltip component — see composition and states for behavior.",
  "props": [
    {
      "name": "content",
      "type": "Node",
      "required": true
    },
    {
      "name": "side",
      "type": "TooltipSide",
      "required": false,
      "default": "'top'"
    }
  ],
  "events": [],
  "states": [
    "default"
  ],
  "defaults": {
    "side": "'top'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "keys": [
      "Escape"
    ],
    "behavior": [
      "escape-close"
    ]
  }
}
