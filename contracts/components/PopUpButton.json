{
  "name": "PopUpButton",
  "version": "1",
  "framework": "neutral",
  "purpose": "PopUpButton component — see composition and states for behavior.",
  "props": [
    {
      "name": "customOption",
      "type": "PopUpCustomOption",
      "required": false
    },
    {
      "name": "defaultValue",
      "type": "string",
      "required": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "explanatoryText",
      "type": "string",
      "required": false,
      "description": "Optional explanatory text below the control."
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "description": "Introductory label describing the control (Calendar-style)."
    },
    {
      "name": "options",
      "type": "PopUpOption[]",
      "required": true
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "default": "'Select…'"
    },
    {
      "name": "value",
      "type": "string",
      "required": false
    }
  ],
  "events": [
    {
      "name": "valueChange",
      "payload": "(value: string) => void"
    }
  ],
  "states": [
    "default",
    "disabled"
  ],
  "defaults": {
    "disabled": "false",
    "placeholder": "'Select…'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  },
  "uncontrolled": [
    "value"
  ]
}
