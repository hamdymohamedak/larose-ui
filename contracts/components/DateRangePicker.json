{
  "name": "DateRangePicker",
  "version": "1",
  "framework": "react",
  "props": [
    {
      "name": "disabled",
      "type": "boolean",
      "required": false
    },
    {
      "name": "endLabel",
      "type": "string",
      "required": false,
      "default": "'End date'"
    },
    {
      "name": "error",
      "type": "string | null",
      "required": false,
      "default": "null"
    },
    {
      "name": "hint",
      "type": "string",
      "required": false
    },
    {
      "name": "inputSize",
      "type": "Size",
      "required": false,
      "default": "'md'"
    },
    {
      "name": "label",
      "type": "string",
      "required": false
    },
    {
      "name": "loading",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "max",
      "type": "string",
      "required": false
    },
    {
      "name": "min",
      "type": "string",
      "required": false
    },
    {
      "name": "readOnly",
      "type": "boolean",
      "required": false
    },
    {
      "name": "startLabel",
      "type": "string",
      "required": false,
      "default": "'Start date'"
    },
    {
      "name": "state",
      "type": "UIState",
      "required": false
    },
    {
      "name": "value",
      "type": "DateRange",
      "required": false,
      "default": "{ startDate: ''"
    }
  ],
  "events": [
    {
      "name": "onChange",
      "payload": "(value: DateRange) => void"
    }
  ],
  "defaults": {
    "endLabel": "'End date'",
    "error": "null",
    "inputSize": "'md'",
    "loading": "false",
    "startLabel": "'Start date'",
    "value": "{ startDate: ''"
  },
  "keyboard": {},
  "controlled": [
    "value"
  ]
}
