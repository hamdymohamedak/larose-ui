{
  "name": "DisclosureButton",
  "version": "1",
  "framework": "neutral",
  "purpose": "DisclosureButton component — see composition and states for behavior.",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "defaultExpanded",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "detail",
      "type": "Node",
      "required": false,
      "description": "Content revealed when expanded. Use only one disclosure button per view."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "expanded",
      "type": "boolean",
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "description": "Visible label for the adjacent control region."
    }
  ],
  "events": [
    {
      "name": "expandedChange",
      "payload": "(expanded: boolean) => void"
    }
  ],
  "states": [
    "default",
    "disabled"
  ],
  "defaults": {
    "defaultExpanded": "false",
    "disabled": "false"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
