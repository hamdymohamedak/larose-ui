{
  "name": "Collapse",
  "version": "1",
  "framework": "neutral",
  "purpose": "Collapse component — see composition and states for behavior.",
  "props": [
    {
      "name": "duration",
      "type": "string",
      "required": false
    },
    {
      "name": "open",
      "type": "boolean",
      "required": true
    }
  ],
  "events": [],
  "states": [
    "default",
    "open",
    "closed"
  ],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
