{
  "name": "TokenField",
  "version": "1",
  "framework": "neutral",
  "purpose": "TokenField component — see composition and states for behavior.",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "defaultTokens",
      "type": "TokenFieldToken[]",
      "required": false
    },
    {
      "name": "delimiters",
      "type": "string[]",
      "required": false,
      "description": "Keys that convert current text into a token (default: comma)."
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false
    },
    {
      "name": "suggestionDelayMs",
      "type": "number",
      "required": false
    },
    {
      "name": "suggestions",
      "type": "TokenFieldToken[]",
      "required": false
    },
    {
      "name": "tokens",
      "type": "TokenFieldToken[]",
      "required": false
    }
  ],
  "events": [
    {
      "name": "contextMenuEntries",
      "payload": "(token: TokenFieldToken) => MenuEntry[]"
    },
    {
      "name": "tokensChange",
      "payload": "(tokens: TokenFieldToken[]) => void"
    }
  ],
  "states": [
    "default"
  ],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
