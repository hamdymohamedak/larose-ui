{
  "name": "Alert",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "onDismiss",
      "type": "() => void",
      "required": false
    },
    {
      "name": "variant",
      "type": "AlertVariant",
      "required": false,
      "default": "'info'"
    }
  ],
  "events": [
    {
      "name": "onDismiss",
      "payload": "() => void"
    }
  ],
  "defaults": {
    "variant": "'info'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
