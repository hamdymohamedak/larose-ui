{
  "name": "Alert",
  "version": "1",
  "framework": "neutral",
  "purpose": "Alert component — see composition and states for behavior.",
  "props": [
    {
      "name": "title",
      "type": "string",
      "required": false
    },
    {
      "name": "variant",
      "type": "AlertVariant",
      "required": false,
      "default": "'info'"
    }
  ],
  "events": [
    {
      "name": "dismiss",
      "payload": "() => void"
    }
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "variant": "'info'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
