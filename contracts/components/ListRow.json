{
  "name": "ListRow",
  "version": "1",
  "framework": "neutral",
  "purpose": "ListRow component — see composition and states for behavior.",
  "props": [
    {
      "name": "accessory",
      "type": "ListAccessory",
      "required": false,
      "default": "'none'"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "leading",
      "type": "Node",
      "required": false
    },
    {
      "name": "selected",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "subtitle",
      "type": "string",
      "required": false
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "truncate",
      "type": "'end' | 'middle'",
      "required": false,
      "default": "'end'"
    }
  ],
  "events": [
    {
      "name": "info",
      "payload": "(event: MouseEvent) => void"
    },
    {
      "name": "press",
      "payload": "() => void"
    }
  ],
  "states": [
    "default",
    "disabled"
  ],
  "defaults": {
    "accessory": "'none'",
    "disabled": "false",
    "selected": "false",
    "truncate": "'end'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
