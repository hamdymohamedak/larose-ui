{
  "name": "ListRow",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "accessory",
      "type": "ListAccessory",
      "required": false,
      "default": "'none'"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "leading",
      "type": "Node",
      "required": false
    },
    {
      "name": "onInfo",
      "type": "(event: MouseEvent) => void",
      "required": false
    },
    {
      "name": "onPress",
      "type": "() => void",
      "required": false
    },
    {
      "name": "selected",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "subtitle",
      "type": "string",
      "required": false
    },
    {
      "name": "truncate",
      "type": "'end' | 'middle'",
      "required": false,
      "default": "'end'"
    }
  ],
  "events": [
    {
      "name": "onInfo",
      "payload": "(event: MouseEvent) => void"
    },
    {
      "name": "onPress",
      "payload": "() => void"
    }
  ],
  "defaults": {
    "accessory": "'none'",
    "disabled": "false",
    "selected": "false",
    "truncate": "'end'"
  },
  "keyboard": {}
}
