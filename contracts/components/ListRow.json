{
  "name": "ListRow",
  "version": "1",
  "framework": "react",
  "props": [
    {
      "name": "accessory",
      "type": "ListAccessory",
      "required": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false
    },
    {
      "name": "leading",
      "type": "ReactNode",
      "required": false
    },
    {
      "name": "onInfo",
      "type": "(event: MouseEvent<HTMLButtonElement>) => void",
      "required": false
    },
    {
      "name": "onPress",
      "type": "() => void",
      "required": false
    },
    {
      "name": "selected",
      "type": "boolean",
      "required": false
    },
    {
      "name": "subtitle",
      "type": "string",
      "required": false
    },
    {
      "name": "truncate",
      "type": "'end' | 'middle'",
      "required": false
    }
  ],
  "events": [
    {
      "name": "onInfo",
      "payload": "(event: MouseEvent<HTMLButtonElement>) => void"
    },
    {
      "name": "onPress",
      "payload": "() => void"
    }
  ],
  "keyboard": {}
}
