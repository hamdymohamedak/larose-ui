{
  "name": "Collection",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "ariaLabel",
      "type": "string",
      "required": false,
      "default": "'Collection'"
    },
    {
      "name": "columns",
      "type": "number",
      "required": false,
      "default": "4"
    },
    {
      "name": "items",
      "type": "CollectionItem[]",
      "required": true
    },
    {
      "name": "layout",
      "type": "CollectionLayout",
      "required": false,
      "default": "'grid'"
    },
    {
      "name": "onSelect",
      "type": "(item: CollectionItem) => void",
      "required": false
    },
    {
      "name": "selectedId",
      "type": "string",
      "required": false
    }
  ],
  "events": [
    {
      "name": "onSelect",
      "payload": "(item: CollectionItem) => void"
    }
  ],
  "defaults": {
    "ariaLabel": "'Collection'",
    "columns": "4",
    "layout": "'grid'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
