{
  "name": "Modal",
  "version": "1",
  "framework": "neutral",
  "purpose": "Modal renders a portal overlay with focus trap, enter/exit motion, and optional title/description.",
  "composition": "Control open state externally. Provide title and description for accessible naming. Portal + presence motion are required on every framework.",
  "interactions": [
    "Modal (root portal)",
    "Overlay",
    "Content",
    "Title",
    "Description",
    "Body (default slot)"
  ],
  "props": [
    {
      "name": "closeOnOverlay",
      "type": "boolean",
      "required": false
    },
    {
      "name": "contentClass",
      "type": "string",
      "required": false
    },
    {
      "name": "contentStyle",
      "type": "Style",
      "required": false
    },
    {
      "name": "description",
      "type": "string",
      "required": false
    },
    {
      "name": "motion",
      "type": "ComponentMotionOverride",
      "required": false
    },
    {
      "name": "open",
      "type": "boolean",
      "required": true
    },
    {
      "name": "overlayClass",
      "type": "string",
      "required": false
    },
    {
      "name": "overlayStyle",
      "type": "Style",
      "required": false
    },
    {
      "name": "title",
      "type": "string",
      "required": false
    }
  ],
  "events": [
    {
      "name": "close",
      "payload": "() => void"
    }
  ],
  "slots": [
    "default"
  ],
  "states": [
    "closed",
    "open",
    "entering",
    "exiting"
  ],
  "accessibility": {
    "requirements": [
      "Focus is managed while open; Escape typically closes the overlay."
    ],
    "aria": []
  },
  "keyboard": {
    "keys": [
      "Escape"
    ],
    "behavior": [
      "escape-close",
      "focus-trap",
      "restore-focus"
    ]
  },
  "focus": [
    "trap-while-open",
    "restore-on-close"
  ],
  "motion": [
    "enter",
    "exit",
    "reduced-motion"
  ]
}
