{
  "name": "FileBrowser",
  "version": "1",
  "framework": "neutral",
  "purpose": "FileBrowser component — see composition and states for behavior.",
  "props": [
    {
      "name": "acceptTypes",
      "type": "string[]",
      "required": false
    },
    {
      "name": "activeTab",
      "type": "FileBrowserTab",
      "required": false,
      "default": "'recents'"
    },
    {
      "name": "emptyLabel",
      "type": "string",
      "required": false,
      "default": "'No documents in this location.'"
    },
    {
      "name": "files",
      "type": "FileBrowserItem[]",
      "required": true
    },
    {
      "name": "selectedId",
      "type": "string",
      "required": false
    },
    {
      "name": "showExtensions",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "toolbar",
      "type": "Node",
      "required": false
    }
  ],
  "events": [
    {
      "name": "open",
      "payload": "(file: FileBrowserItem) => void"
    },
    {
      "name": "select",
      "payload": "(file: FileBrowserItem) => void"
    },
    {
      "name": "showExtensionsChange",
      "payload": "(show: boolean) => void"
    },
    {
      "name": "tabChange",
      "payload": "(tab: FileBrowserTab) => void"
    }
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "activeTab": "'recents'",
    "emptyLabel": "'No documents in this location.'",
    "showExtensions": "false"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
