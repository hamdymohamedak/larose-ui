{
  "name": "FileBrowser",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "acceptTypes",
      "type": "string[]",
      "required": false
    },
    {
      "name": "activeTab",
      "type": "FileBrowserTab",
      "required": false,
      "default": "'recents'"
    },
    {
      "name": "emptyLabel",
      "type": "string",
      "required": false,
      "default": "'No documents in this location.'"
    },
    {
      "name": "files",
      "type": "FileBrowserItem[]",
      "required": true
    },
    {
      "name": "onOpen",
      "type": "(file: FileBrowserItem) => void",
      "required": false
    },
    {
      "name": "onSelect",
      "type": "(file: FileBrowserItem) => void",
      "required": false
    },
    {
      "name": "onShowExtensionsChange",
      "type": "(show: boolean) => void",
      "required": false
    },
    {
      "name": "onTabChange",
      "type": "(tab: FileBrowserTab) => void",
      "required": false
    },
    {
      "name": "selectedId",
      "type": "string",
      "required": false
    },
    {
      "name": "showExtensions",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "toolbar",
      "type": "Node",
      "required": false
    }
  ],
  "events": [
    {
      "name": "onOpen",
      "payload": "(file: FileBrowserItem) => void"
    },
    {
      "name": "onSelect",
      "payload": "(file: FileBrowserItem) => void"
    },
    {
      "name": "onShowExtensionsChange",
      "payload": "(show: boolean) => void"
    },
    {
      "name": "onTabChange",
      "payload": "(tab: FileBrowserTab) => void"
    }
  ],
  "defaults": {
    "activeTab": "'recents'",
    "emptyLabel": "'No documents in this location.'",
    "showExtensions": "false"
  },
  "keyboard": {}
}
