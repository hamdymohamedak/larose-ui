{
  "name": "HomeScreenQuickActions",
  "version": "1",
  "framework": "neutral",
  "purpose": "HomeScreenQuickActions component — see composition and states for behavior.",
  "props": [
    {
      "name": "actions",
      "type": "QuickActionItem[]",
      "required": true
    },
    {
      "name": "appName",
      "type": "string",
      "required": true
    },
    {
      "name": "icon",
      "type": "Node",
      "required": true
    },
    {
      "name": "iconPlacement",
      "type": "QuickActionIconPlacement",
      "required": false,
      "default": "'leading'",
      "description": "Icon appears on leading or trailing edge depending on Home Screen position."
    },
    {
      "name": "includeSystemActions",
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false
    },
    {
      "name": "systemActions",
      "type": "QuickActionItem[]",
      "required": false
    }
  ],
  "events": [
    {
      "name": "actionSelect",
      "payload": "(action: QuickActionItem) => void"
    },
    {
      "name": "openChange",
      "payload": "(open: boolean) => void"
    }
  ],
  "states": [
    "default",
    "open",
    "closed"
  ],
  "defaults": {
    "iconPlacement": "'leading'",
    "includeSystemActions": "true"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  },
  "controlled": [
    "open"
  ]
}
