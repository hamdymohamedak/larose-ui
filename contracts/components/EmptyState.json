{
  "name": "EmptyState",
  "version": "1",
  "framework": "neutral",
  "purpose": "EmptyState component — see composition and states for behavior.",
  "props": [
    {
      "name": "actionLabel",
      "type": "string",
      "required": false
    },
    {
      "name": "description",
      "type": "string",
      "required": false
    },
    {
      "name": "icon",
      "type": "Node",
      "required": false
    },
    {
      "name": "state",
      "type": "UIState",
      "required": false,
      "default": "'empty'"
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    }
  ],
  "events": [
    {
      "name": "action",
      "payload": "() => void"
    }
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "state": "'empty'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
