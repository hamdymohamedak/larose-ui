{
  "name": "EmptyState",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "actionLabel",
      "type": "string",
      "required": false
    },
    {
      "name": "description",
      "type": "string",
      "required": false
    },
    {
      "name": "icon",
      "type": "Node",
      "required": false
    },
    {
      "name": "onAction",
      "type": "() => void",
      "required": false
    },
    {
      "name": "state",
      "type": "UIState",
      "required": false,
      "default": "'empty'"
    }
  ],
  "events": [
    {
      "name": "onAction",
      "payload": "() => void"
    }
  ],
  "defaults": {
    "state": "'empty'"
  },
  "keyboard": {}
}
