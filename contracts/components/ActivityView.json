{
  "name": "ActivityView",
  "version": "1",
  "framework": "neutral",
  "purpose": "ActivityView component — see composition and states for behavior.",
  "props": [
    {
      "name": "activities",
      "type": "ActivityItem[]",
      "required": true
    },
    {
      "name": "anchorRef",
      "type": "React.Ref",
      "required": false,
      "description": "Used for popover positioning when presentation is popover."
    },
    {
      "name": "excludedActivityIds",
      "type": "string[]",
      "required": false,
      "default": "[]"
    },
    {
      "name": "footer",
      "type": "Node",
      "required": false
    },
    {
      "name": "open",
      "type": "boolean",
      "required": true
    },
    {
      "name": "presentation",
      "type": "ActivityPresentation",
      "required": false,
      "default": "'sheet'"
    },
    {
      "name": "title",
      "type": "string",
      "required": false
    }
  ],
  "events": [
    {
      "name": "activitySelect",
      "payload": "(activity: ActivityItem) => void"
    },
    {
      "name": "close",
      "payload": "() => void"
    }
  ],
  "states": [
    "default",
    "open",
    "closed"
  ],
  "defaults": {
    "excludedActivityIds": "[]",
    "presentation": "'sheet'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
