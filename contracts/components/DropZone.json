{
  "name": "DropZone",
  "version": "1",
  "framework": "neutral",
  "purpose": "DropZone component — see composition and states for behavior.",
  "props": [
    {
      "name": "accepts",
      "type": "string | string[]",
      "required": false
    },
    {
      "name": "canDrop",
      "type": "(items: DragItem<T>[]) => boolean",
      "required": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "showInvalidIndicator",
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    {
      "name": "transferring",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "transferringLabel",
      "type": "string",
      "required": false,
      "default": "'Transferring…'"
    }
  ],
  "events": [
    {
      "name": "drop",
      "payload": "(result: DropResult<T>) => void | Promise<void>"
    }
  ],
  "states": [
    "default",
    "disabled"
  ],
  "defaults": {
    "disabled": "false",
    "showInvalidIndicator": "true",
    "transferring": "false",
    "transferringLabel": "'Transferring…'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
