{
  "name": "TabView",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "defaultValue",
      "type": "string",
      "required": false,
      "default": "''"
    },
    {
      "name": "inset",
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    {
      "name": "onValueChange",
      "type": "(value: string) => void",
      "required": false
    },
    {
      "name": "showTabs",
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    {
      "name": "value",
      "type": "string",
      "required": false
    },
    {
      "name": "variant",
      "type": "TabViewVariant",
      "required": false,
      "default": "'bordered'"
    }
  ],
  "events": [
    {
      "name": "onValueChange",
      "payload": "(value: string) => void"
    }
  ],
  "slots": [
    "children"
  ],
  "states": [
    "default",
    "active tab"
  ],
  "defaults": {
    "defaultValue": "''",
    "inset": "true",
    "showTabs": "true",
    "variant": "'bordered'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  },
  "uncontrolled": [
    "value"
  ]
}
