{
  "name": "ToolbarSearch",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false
    },
    {
      "name": "value",
      "type": "string",
      "required": false
    }
  ],
  "events": [
    {
      "name": "onChange",
      "payload": "(value: string) => void"
    }
  ],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  },
  "controlled": [
    "value"
  ]
}
