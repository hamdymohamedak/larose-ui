{
  "name": "ShareSheet",
  "version": "1",
  "framework": "neutral",
  "purpose": "ShareSheet component — see composition and states for behavior.",
  "props": [
    {
      "name": "destinations",
      "type": "ShareDestination[]",
      "required": false,
      "default": "defaultDestinations"
    },
    {
      "name": "footer",
      "type": "Node",
      "required": false
    },
    {
      "name": "open",
      "type": "boolean",
      "required": true
    },
    {
      "name": "permissionOptions",
      "type": "SharePermissionOption[]",
      "required": false,
      "default": "defaultPermissionOptions"
    },
    {
      "name": "settings",
      "type": "ShareSettings",
      "required": true
    },
    {
      "name": "title",
      "type": "string",
      "required": false,
      "default": "'Share'"
    }
  ],
  "events": [
    {
      "name": "close",
      "payload": "() => void"
    },
    {
      "name": "settingsChange",
      "payload": "(settings: ShareSettings) => void"
    }
  ],
  "states": [
    "default",
    "open",
    "closed"
  ],
  "defaults": {
    "destinations": "defaultDestinations",
    "permissionOptions": "defaultPermissionOptions",
    "title": "'Share'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
