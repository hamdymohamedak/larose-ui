{
  "name": "OutlineViewToolbar",
  "version": "1",
  "framework": "neutral",
  "purpose": "OutlineViewToolbar component — see composition and states for behavior.",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "default": "'Search'"
    },
    {
      "name": "searchQuery",
      "type": "string",
      "required": true
    }
  ],
  "events": [
    {
      "name": "searchChange",
      "payload": "(query: string) => void"
    }
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "placeholder": "'Search'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
