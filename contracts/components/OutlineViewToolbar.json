{
  "name": "OutlineViewToolbar",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "onSearchChange",
      "type": "(query: string) => void",
      "required": true
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false
    },
    {
      "name": "searchQuery",
      "type": "string",
      "required": true
    }
  ],
  "events": [
    {
      "name": "onSearchChange",
      "payload": "(query: string) => void"
    }
  ],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
