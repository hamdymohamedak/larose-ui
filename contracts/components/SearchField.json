{
  "name": "SearchField",
  "version": "1",
  "framework": "neutral",
  "purpose": "SearchField component — see composition and states for behavior.",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "autoFocus",
      "type": "boolean",
      "required": false
    },
    {
      "name": "defaultValue",
      "type": "string",
      "required": false
    },
    {
      "name": "immediate",
      "type": "boolean",
      "required": false,
      "description": "Search while typing (default true)."
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false
    },
    {
      "name": "placement",
      "type": "SearchFieldPlacement",
      "required": false
    },
    {
      "name": "platform",
      "type": "SearchFieldPlatform",
      "required": false
    },
    {
      "name": "recentSearches",
      "type": "string[]",
      "required": false
    },
    {
      "name": "scope",
      "type": "{ options: SearchScopeOption[]; value: string; onChange: (scopeId: string) => void; }",
      "required": false
    },
    {
      "name": "showDictation",
      "type": "boolean",
      "required": false
    },
    {
      "name": "suggestions",
      "type": "string[]",
      "required": false
    },
    {
      "name": "tokens",
      "type": "SearchToken[]",
      "required": false
    },
    {
      "name": "value",
      "type": "string",
      "required": false
    }
  ],
  "events": [
    {
      "name": "search",
      "payload": "(value: string) => void"
    },
    {
      "name": "tokenRemove",
      "payload": "(tokenId: string) => void"
    },
    {
      "name": "tokenSelect",
      "payload": "(tokenId: string) => void"
    },
    {
      "name": "change",
      "payload": "(value: string) => void"
    }
  ],
  "states": [
    "default"
  ],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  },
  "controlled": [
    "value"
  ],
  "uncontrolled": [
    "value"
  ]
}
