{
  "name": "Label",
  "version": "1",
  "framework": "neutral",
  "purpose": "Label component — see composition and states for behavior.",
  "props": [
    {
      "name": "as",
      "type": "ElementTag",
      "required": false
    },
    {
      "name": "importance",
      "type": "LabelImportance",
      "required": false,
      "default": "'primary'",
      "description": "System label color indicating relative importance."
    },
    {
      "name": "mono",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "selectable",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "Allow selecting/copying useful static text."
    }
  ],
  "events": [],
  "states": [
    "default"
  ],
  "defaults": {
    "importance": "'primary'",
    "mono": "false",
    "selectable": "false"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
