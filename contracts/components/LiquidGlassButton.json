{
  "name": "LiquidGlassButton",
  "version": "1",
  "framework": "neutral",
  "purpose": "Pill button with full liquid glass optics exposed for tuning.",
  "composition": "Use for primary actions on colorful or photographic backgrounds.",
  "interactions": [
    "LiquidGlass button shell",
    "Label / icon children"
  ],
  "props": [
    {
      "name": "borderRadius",
      "type": "number",
      "required": false,
      "default": "LIQUID_GLASS_PRESETS.button.borderRadius"
    },
    {
      "name": "color",
      "type": "string",
      "required": false,
      "default": "'#ffffff'",
      "description": "Text/icon colour."
    },
    {
      "name": "fontSize",
      "type": "string | number",
      "required": false,
      "default": "'0.9375rem'",
      "description": "Font size."
    },
    {
      "name": "fontWeight",
      "type": "number",
      "required": false,
      "default": "500",
      "description": "Font weight."
    },
    {
      "name": "height",
      "type": "number | string",
      "required": false,
      "default": "48"
    },
    {
      "name": "width",
      "type": "number | string",
      "required": false,
      "default": "140"
    }
  ],
  "events": [],
  "slots": [
    "default"
  ],
  "states": [
    "default",
    "disabled",
    "hover",
    "active"
  ],
  "defaults": {
    "borderRadius": "LIQUID_GLASS_PRESETS.button.borderRadius",
    "color": "'#ffffff'",
    "fontSize": "'0.9375rem'",
    "fontWeight": "500",
    "height": "48",
    "width": "140"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
