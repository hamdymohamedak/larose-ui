{
  "name": "PathControl",
  "version": "1",
  "framework": "neutral",
  "purpose": "PathControl component — see composition and states for behavior.",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "editable",
      "type": "boolean",
      "required": false,
      "description": "macOS: allow drag-and-drop to select a new path item."
    },
    {
      "name": "segments",
      "type": "PathSegment[]",
      "required": true
    },
    {
      "name": "selectedId",
      "type": "string",
      "required": false
    },
    {
      "name": "variant",
      "type": "PathControlVariant",
      "required": false
    }
  ],
  "events": [
    {
      "name": "choose",
      "payload": "() => void"
    },
    {
      "name": "dropPath",
      "payload": "(segments: PathSegment[]) => void"
    },
    {
      "name": "segmentSelect",
      "payload": "(segment: PathSegment) => void"
    }
  ],
  "states": [
    "default"
  ],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
