{
  "name": "CalendarGrid",
  "version": "1",
  "framework": "neutral",
  "purpose": "CalendarGrid component — see composition and states for behavior.",
  "props": [
    {
      "name": "locale",
      "type": "string",
      "required": false,
      "default": "'en'"
    },
    {
      "name": "maxDate",
      "type": "string",
      "required": false
    },
    {
      "name": "minDate",
      "type": "string",
      "required": false
    },
    {
      "name": "value",
      "type": "string",
      "required": false
    }
  ],
  "events": [
    {
      "name": "change",
      "payload": "(isoDate: string) => void"
    }
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "locale": "'en'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  },
  "controlled": [
    "value"
  ]
}
