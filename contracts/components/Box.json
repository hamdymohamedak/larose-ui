{
  "name": "Box",
  "version": "1",
  "framework": "neutral",
  "purpose": "Box component — see composition and states for behavior.",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "padding",
      "type": "'sm' | 'md' | 'lg'",
      "required": false,
      "default": "'md'"
    },
    {
      "name": "settingsStyle",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "macOS settings panes append a colon to the title."
    },
    {
      "name": "title",
      "type": "string",
      "required": false
    },
    {
      "name": "titlePosition",
      "type": "BoxTitlePosition",
      "required": false,
      "default": "'inside'"
    },
    {
      "name": "variant",
      "type": "BoxVariant",
      "required": false,
      "default": "'secondary'"
    }
  ],
  "events": [],
  "states": [
    "default"
  ],
  "defaults": {
    "padding": "'md'",
    "settingsStyle": "false",
    "titlePosition": "'inside'",
    "variant": "'secondary'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
