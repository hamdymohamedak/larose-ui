{
  "name": "Box",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "padding",
      "type": "'sm' | 'md' | 'lg'",
      "required": false
    },
    {
      "name": "settingsStyle",
      "type": "boolean",
      "required": false,
      "description": "macOS settings panes append a colon to the title."
    },
    {
      "name": "titlePosition",
      "type": "BoxTitlePosition",
      "required": false
    },
    {
      "name": "variant",
      "type": "BoxVariant",
      "required": false
    }
  ],
  "events": [],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
