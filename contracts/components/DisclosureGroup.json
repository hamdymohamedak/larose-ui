{
  "name": "DisclosureGroup",
  "version": "1",
  "framework": "neutral",
  "purpose": "DisclosureGroup component — see composition and states for behavior.",
  "props": [
    {
      "name": "defaultExpanded",
      "type": "boolean",
      "required": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false
    },
    {
      "name": "expanded",
      "type": "boolean",
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "required": true
    }
  ],
  "events": [
    {
      "name": "expandedChange",
      "payload": "(expanded: boolean) => void"
    }
  ],
  "states": [
    "default",
    "disabled"
  ],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
