{
  "name": "FileUpload",
  "version": "1",
  "framework": "neutral",
  "purpose": "FileUpload component — see composition and states for behavior.",
  "props": [
    {
      "name": "accept",
      "type": "string",
      "required": false
    },
    {
      "name": "buttonLabel",
      "type": "string",
      "required": false,
      "default": "'Choose files or drag here'"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "error",
      "type": "string | null",
      "required": false,
      "default": "null"
    },
    {
      "name": "hint",
      "type": "string",
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "required": false
    },
    {
      "name": "multiple",
      "type": "boolean",
      "required": false,
      "default": "false"
    }
  ],
  "events": [
    {
      "name": "filesChange",
      "payload": "(files: File[]) => void"
    }
  ],
  "states": [
    "default",
    "disabled",
    "error"
  ],
  "defaults": {
    "buttonLabel": "'Choose files or drag here'",
    "disabled": "false",
    "error": "null",
    "multiple": "false"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
