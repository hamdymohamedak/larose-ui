{
  "name": "Card",
  "version": "1",
  "framework": "neutral",
  "purpose": "Card groups related content with optional title and padding tokens.",
  "composition": "Use padding tokens or Card defaultProps for density consistency.",
  "interactions": [
    "Card",
    "Header/Title",
    "Body",
    "Footer actions"
  ],
  "props": [
    {
      "name": "description",
      "type": "string",
      "required": false
    },
    {
      "name": "footer",
      "type": "Node",
      "required": false
    },
    {
      "name": "padding",
      "type": "'none' | 'sm' | 'md' | 'lg'",
      "required": false,
      "default": "'md'"
    },
    {
      "name": "title",
      "type": "string",
      "required": false
    }
  ],
  "events": [],
  "slots": [
    "default",
    "title"
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "padding": "'md'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
