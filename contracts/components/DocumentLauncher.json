{
  "name": "DocumentLauncher",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "accessories",
      "type": "Node",
      "required": false
    },
    {
      "name": "appTitle",
      "type": "string",
      "required": true
    },
    {
      "name": "background",
      "type": "Node",
      "required": false
    },
    {
      "name": "onPrimaryAction",
      "type": "() => void",
      "required": false
    },
    {
      "name": "onSecondaryAction",
      "type": "() => void",
      "required": false
    },
    {
      "name": "primaryActionLabel",
      "type": "string",
      "required": false,
      "default": "'Create Document'"
    },
    {
      "name": "secondaryActionLabel",
      "type": "string",
      "required": false,
      "default": "'Choose Template'"
    }
  ],
  "events": [
    {
      "name": "onPrimaryAction",
      "payload": "() => void"
    },
    {
      "name": "onSecondaryAction",
      "payload": "() => void"
    }
  ],
  "defaults": {
    "primaryActionLabel": "'Create Document'",
    "secondaryActionLabel": "'Choose Template'"
  },
  "keyboard": {}
}
