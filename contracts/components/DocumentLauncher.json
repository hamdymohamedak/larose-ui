{
  "name": "DocumentLauncher",
  "version": "1",
  "framework": "neutral",
  "purpose": "DocumentLauncher component — see composition and states for behavior.",
  "props": [
    {
      "name": "accessories",
      "type": "Node",
      "required": false
    },
    {
      "name": "appTitle",
      "type": "string",
      "required": true
    },
    {
      "name": "background",
      "type": "Node",
      "required": false
    },
    {
      "name": "primaryActionLabel",
      "type": "string",
      "required": false,
      "default": "'Create Document'"
    },
    {
      "name": "secondaryActionLabel",
      "type": "string",
      "required": false,
      "default": "'Choose Template'"
    }
  ],
  "events": [
    {
      "name": "primaryAction",
      "payload": "() => void"
    },
    {
      "name": "secondaryAction",
      "payload": "() => void"
    }
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "primaryActionLabel": "'Create Document'",
    "secondaryActionLabel": "'Choose Template'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
