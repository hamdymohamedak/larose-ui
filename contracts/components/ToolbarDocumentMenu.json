{
  "name": "ToolbarDocumentMenu",
  "version": "1",
  "framework": "neutral",
  "purpose": "ToolbarDocumentMenu component — see composition and states for behavior.",
  "props": [
    {
      "name": "disabled",
      "type": "boolean",
      "required": false
    },
    {
      "name": "entries",
      "type": "MenuEntry[]",
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "required": false
    }
  ],
  "events": [
    {
      "name": "action",
      "payload": "(entryId: string) => void"
    }
  ],
  "states": [
    "default",
    "disabled"
  ],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
