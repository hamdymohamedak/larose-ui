{
  "name": "DragDropList",
  "version": "1",
  "framework": "neutral",
  "purpose": "DragDropList component — see composition and states for behavior.",
  "props": [
    {
      "name": "items",
      "type": "DragDropListItem[]",
      "required": true
    },
    {
      "name": "renderItem",
      "type": "(item: DragDropListItem) => Node",
      "required": false
    },
    {
      "name": "zoneId",
      "type": "string",
      "required": false,
      "default": "'list'"
    }
  ],
  "events": [
    {
      "name": "reorder",
      "payload": "(items: DragDropListItem[]) => void"
    }
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "zoneId": "'list'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
