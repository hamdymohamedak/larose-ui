{
  "name": "ContextMenu",
  "version": "1",
  "framework": "neutral",
  "purpose": "ContextMenu component — see composition and states for behavior.",
  "props": [
    {
      "name": "dimBackground",
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    {
      "name": "entries",
      "type": "ContextMenuEntry[]",
      "required": true
    },
    {
      "name": "longPress",
      "type": "boolean",
      "required": false,
      "default": "true",
      "description": "Enable long-press / touch-and-hold in addition to secondary click."
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false
    },
    {
      "name": "preview",
      "type": "Node",
      "required": false
    },
    {
      "name": "title",
      "type": "string",
      "required": false
    }
  ],
  "events": [
    {
      "name": "entrySelect",
      "payload": "(entry: ContextMenuItemConfig) => void"
    },
    {
      "name": "openChange",
      "payload": "(open: boolean) => void"
    }
  ],
  "states": [
    "default",
    "open",
    "closed"
  ],
  "defaults": {
    "dimBackground": "true",
    "longPress": "true"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  },
  "controlled": [
    "open"
  ]
}
