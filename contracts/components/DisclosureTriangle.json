{
  "name": "DisclosureTriangle",
  "version": "1",
  "framework": "react",
  "props": [
    {
      "name": "defaultExpanded",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "expanded",
      "type": "boolean",
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Describes what is disclosed, e.g. \"Advanced options\"."
    },
    {
      "name": "onExpandedChange",
      "type": "(expanded: boolean) => void",
      "required": false
    }
  ],
  "events": [
    {
      "name": "onExpandedChange",
      "payload": "(expanded: boolean) => void"
    }
  ],
  "defaults": {
    "defaultExpanded": "false",
    "disabled": "false"
  },
  "keyboard": {}
}
