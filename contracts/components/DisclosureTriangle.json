{
  "name": "DisclosureTriangle",
  "version": "1",
  "framework": "neutral",
  "purpose": "DisclosureTriangle component — see composition and states for behavior.",
  "props": [
    {
      "name": "defaultExpanded",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "expanded",
      "type": "boolean",
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Describes what is disclosed, e.g. \"Advanced options\"."
    }
  ],
  "events": [
    {
      "name": "expandedChange",
      "payload": "(expanded: boolean) => void"
    }
  ],
  "states": [
    "default",
    "disabled"
  ],
  "defaults": {
    "defaultExpanded": "false",
    "disabled": "false"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
