{
  "name": "LiquidGlassCheckbox",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "borderRadius",
      "type": "number",
      "required": false,
      "default": "LIQUID_GLASS_PRESETS.checkbox.borderRadius"
    },
    {
      "name": "checkColor",
      "type": "string",
      "required": false,
      "default": "'#ffffff'"
    },
    {
      "name": "checked",
      "type": "boolean",
      "required": false
    },
    {
      "name": "checkedTint",
      "type": "string",
      "required": false,
      "default": "'rgba(52, 199, 89, 0.42)'"
    },
    {
      "name": "defaultChecked",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "label",
      "type": "Node",
      "required": false
    },
    {
      "name": "labelColor",
      "type": "string",
      "required": false,
      "default": "'#ffffff'"
    },
    {
      "name": "size",
      "type": "number",
      "required": false,
      "default": "26",
      "description": "Box size in px."
    }
  ],
  "events": [
    {
      "name": "onChange",
      "payload": "(checked: boolean) => void"
    }
  ],
  "slots": [
    "label"
  ],
  "states": [
    "unchecked",
    "checked",
    "disabled"
  ],
  "defaults": {
    "borderRadius": "LIQUID_GLASS_PRESETS.checkbox.borderRadius",
    "checkColor": "'#ffffff'",
    "checkedTint": "'rgba(52, 199, 89, 0.42)'",
    "defaultChecked": "false",
    "disabled": "false",
    "labelColor": "'#ffffff'",
    "size": "26"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  },
  "controlled": [
    "checked"
  ],
  "uncontrolled": [
    "checked"
  ]
}
