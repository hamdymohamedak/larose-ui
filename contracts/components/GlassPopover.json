{
  "name": "GlassPopover",
  "version": "1",
  "framework": "react",
  "props": [
    {
      "name": "defaultOpen",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "lens",
      "type": "Partial<GlassLens>",
      "required": false
    },
    {
      "name": "modal",
      "type": "boolean",
      "required": false,
      "default": "true",
      "description": "Trap focus inside the panel while open (default true)."
    },
    {
      "name": "onOpenChange",
      "type": "(open: boolean) => void",
      "required": false
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false
    },
    {
      "name": "portal",
      "type": "boolean",
      "required": false,
      "default": "true",
      "description": "Render panel in a document.body portal (default true)."
    },
    {
      "name": "trigger",
      "type": "ReactNode",
      "required": true
    },
    {
      "name": "width",
      "type": "number",
      "required": false,
      "default": "DEFAULT_W"
    }
  ],
  "events": [
    {
      "name": "onOpenChange",
      "payload": "(open: boolean) => void"
    }
  ],
  "defaults": {
    "defaultOpen": "false",
    "modal": "true",
    "portal": "true",
    "width": "DEFAULT_W"
  },
  "controlled": [
    "open"
  ],
  "uncontrolled": [
    "open"
  ],
  "package": "@larose-ui/glass/react"
}
