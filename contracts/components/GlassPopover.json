{
  "name": "GlassPopover",
  "version": "1",
  "framework": "react",
  "package": "@larose-ui/glass/react",
  "props": [
    {
      "name": "trigger",
      "type": "ReactNode",
      "required": true
    },
    {
      "name": "children",
      "type": "ReactNode",
      "required": true
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false
    },
    {
      "name": "defaultOpen",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "onOpenChange",
      "type": "(open: boolean) => void",
      "required": false
    },
    {
      "name": "portal",
      "type": "boolean",
      "required": false,
      "default": "true",
      "description": "Render panel in document.body portal to escape overflow clipping."
    },
    {
      "name": "modal",
      "type": "boolean",
      "required": false,
      "default": "true",
      "description": "Trap focus inside panel while open."
    },
    {
      "name": "width",
      "type": "number",
      "required": false
    },
    {
      "name": "lens",
      "type": "Partial<GlassLens>",
      "required": false
    }
  ],
  "events": [
    {
      "name": "onOpenChange",
      "payload": "(open: boolean) => void"
    }
  ],
  "states": ["closed", "open"],
  "accessibility": {
    "requirements": [
      "role=dialog with aria-modal when modal.",
      "Escape closes; focus returns to trigger.",
      "Click outside closes."
    ],
    "aria": ["aria-expanded", "aria-controls", "aria-labelledby", "aria-modal"]
  },
  "keyboard": {
    "keys": ["Escape", "Tab"],
    "behavior": ["escape-close", "focus-trap"]
  },
  "controlled": ["open"],
  "uncontrolled": ["open"]
}
