{
  "name": "Tabs",
  "version": "1",
  "framework": "neutral",
  "purpose": "Accessible tab list with keyboard navigation and optional lazy panels.",
  "composition": "Compose triggers and panels with matching value keys.",
  "interactions": [
    "Tabs",
    "TabsList",
    "TabsTrigger",
    "TabsPanel"
  ],
  "props": [
    {
      "name": "defaultValue",
      "type": "string",
      "required": false,
      "default": "''"
    },
    {
      "name": "value",
      "type": "string",
      "required": false
    }
  ],
  "events": [
    {
      "name": "valueChange",
      "payload": "(value: string) => void"
    }
  ],
  "slots": [
    "default"
  ],
  "states": [
    "default",
    "disabled"
  ],
  "defaults": {
    "defaultValue": "''"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "keys": [
      "ArrowUp",
      "ArrowDown",
      "ArrowLeft",
      "ArrowRight"
    ],
    "behavior": [
      "arrow-navigation",
      "roving-focus"
    ]
  },
  "uncontrolled": [
    "value"
  ]
}
