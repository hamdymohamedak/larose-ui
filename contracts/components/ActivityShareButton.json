{
  "name": "ActivityShareButton",
  "version": "1",
  "framework": "react",
  "props": [
    {
      "name": "activities",
      "type": "ActivityItem[]",
      "required": true
    },
    {
      "name": "excludedActivityIds",
      "type": "string[]",
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "required": false
    },
    {
      "name": "onActivitySelect",
      "type": "(activity: ActivityItem) => void",
      "required": false
    },
    {
      "name": "presentation",
      "type": "'sheet' | 'popover' | 'auto'",
      "required": false,
      "description": "Uses popover on wide viewports and sheet on compact widths when auto."
    }
  ],
  "events": [
    {
      "name": "onActivitySelect",
      "payload": "(activity: ActivityItem) => void"
    }
  ],
  "keyboard": {}
}
