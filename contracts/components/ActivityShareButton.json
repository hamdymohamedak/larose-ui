{
  "name": "ActivityShareButton",
  "version": "1",
  "framework": "neutral",
  "purpose": "ActivityShareButton component — see composition and states for behavior.",
  "props": [
    {
      "name": "activities",
      "type": "ActivityItem[]",
      "required": true
    },
    {
      "name": "excludedActivityIds",
      "type": "string[]",
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "default": "'Share'"
    },
    {
      "name": "presentation",
      "type": "'sheet' | 'popover' | 'auto'",
      "required": false,
      "default": "'auto'",
      "description": "Uses popover on wide viewports and sheet on compact widths when auto."
    },
    {
      "name": "title",
      "type": "string",
      "required": false
    }
  ],
  "events": [
    {
      "name": "activitySelect",
      "payload": "(activity: ActivityItem) => void"
    }
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "label": "'Share'",
    "presentation": "'auto'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
