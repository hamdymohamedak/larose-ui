{
  "name": "ToolbarMoreButton",
  "version": "1",
  "framework": "neutral",
  "purpose": "ToolbarMoreButton component — see composition and states for behavior.",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false
    },
    {
      "name": "entries",
      "type": "MenuEntry[]",
      "required": true
    }
  ],
  "events": [
    {
      "name": "action",
      "payload": "(entryId: string) => void"
    }
  ],
  "states": [
    "default",
    "disabled"
  ],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
