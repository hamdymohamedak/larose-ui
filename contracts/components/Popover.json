{
  "name": "Popover",
  "version": "1",
  "framework": "neutral",
  "purpose": "Popover anchors floating content to a trigger with collision handling.",
  "composition": "Keep content concise; prefer Tooltip for single-line hints.",
  "interactions": [
    "Popover",
    "Trigger",
    "Content"
  ],
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "content",
      "type": "Node",
      "required": true
    },
    {
      "name": "defaultOpen",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false
    },
    {
      "name": "panelClass",
      "type": "string",
      "required": false,
      "description": "Extra class names for the floating panel element."
    },
    {
      "name": "side",
      "type": "PopoverSide",
      "required": false,
      "default": "'bottom'"
    },
    {
      "name": "trigger",
      "type": "Node",
      "required": true
    }
  ],
  "events": [
    {
      "name": "openChange",
      "payload": "(open: boolean) => void"
    }
  ],
  "slots": [
    "trigger",
    "default"
  ],
  "states": [
    "closed",
    "open"
  ],
  "defaults": {
    "defaultOpen": "false",
    "side": "'bottom'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Focus is managed while open; Escape typically closes the overlay."
    ],
    "aria": []
  },
  "keyboard": {
    "keys": [
      "Escape",
      "ArrowUp",
      "ArrowDown",
      "ArrowLeft",
      "ArrowRight"
    ],
    "behavior": [
      "escape-close",
      "arrow-navigation"
    ]
  },
  "controlled": [
    "open"
  ],
  "uncontrolled": [
    "open"
  ]
}
