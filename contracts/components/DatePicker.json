{
  "name": "DatePicker",
  "version": "1",
  "framework": "neutral",
  "purpose": "DatePicker component — see composition and states for behavior.",
  "props": [
    {
      "name": "error",
      "type": "string | null",
      "required": false,
      "default": "null"
    },
    {
      "name": "hint",
      "type": "string",
      "required": false
    },
    {
      "name": "inputSize",
      "type": "Size",
      "required": false,
      "default": "'md'"
    },
    {
      "name": "label",
      "type": "string",
      "required": false
    },
    {
      "name": "loading",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "state",
      "type": "UIState",
      "required": false
    },
    {
      "name": "value",
      "type": "string",
      "required": false,
      "default": "''"
    }
  ],
  "events": [
    {
      "name": "change",
      "payload": "(value: string) => void"
    }
  ],
  "states": [
    "default",
    "loading",
    "error"
  ],
  "defaults": {
    "error": "null",
    "inputSize": "'md'",
    "loading": "false",
    "value": "''"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  },
  "controlled": [
    "value"
  ]
}
