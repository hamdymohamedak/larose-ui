{
  "name": "SidebarItem",
  "version": "1",
  "framework": "neutral",
  "purpose": "SidebarItem component — see composition and states for behavior.",
  "props": [
    {
      "name": "accentColor",
      "type": "string",
      "required": false,
      "description": "Fixed accent color for special icons (e.g. VIP in Mail). Use sparingly."
    },
    {
      "name": "active",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "badge",
      "type": "number | '!'",
      "required": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "href",
      "type": "string",
      "required": false
    },
    {
      "name": "icon",
      "type": "Node",
      "required": false
    }
  ],
  "events": [
    {
      "name": "click",
      "payload": "() => void"
    }
  ],
  "states": [
    "default",
    "disabled"
  ],
  "defaults": {
    "active": "false",
    "disabled": "false"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
