{
  "name": "Progress",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": false
    },
    {
      "name": "max",
      "type": "number",
      "required": false,
      "default": "100"
    },
    {
      "name": "showValue",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "state",
      "type": "UIState",
      "required": false,
      "default": "'idle'"
    },
    {
      "name": "value",
      "type": "number",
      "required": true
    },
    {
      "name": "variant",
      "type": "ProgressVariant",
      "required": false,
      "default": "'default'"
    }
  ],
  "events": [],
  "defaults": {
    "max": "100",
    "showValue": "false",
    "state": "'idle'",
    "variant": "'default'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
