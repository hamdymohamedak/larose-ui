{
  "name": "Menu",
  "version": "1",
  "framework": "neutral",
  "purpose": "Menu component — see composition and states for behavior.",
  "props": [
    {
      "name": "dimBackground",
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    {
      "name": "enableMnemonics",
      "type": "boolean",
      "required": false,
      "default": "true",
      "description": "Enable Alt+key mnemonics while open. Defaults to true."
    },
    {
      "name": "enableShortcuts",
      "type": "boolean",
      "required": false,
      "default": "true",
      "description": "When true, keyboard shortcuts activate menu items while open. Defaults to true."
    },
    {
      "name": "enableTypeAhead",
      "type": "boolean",
      "required": false,
      "default": "true",
      "description": "Enable type-ahead letter matching while open. Defaults to true."
    },
    {
      "name": "entries",
      "type": "MenuEntry[]",
      "required": true
    },
    {
      "name": "layout",
      "type": "MenuLayout",
      "required": false,
      "default": "'large'"
    },
    {
      "name": "mnemonicVisible",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "When true, underline mnemonic access keys in labels."
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false
    },
    {
      "name": "optionKey",
      "type": "boolean",
      "required": false,
      "description": "Passed from MenuBar for Option-key alternate accelerators."
    },
    {
      "name": "title",
      "type": "string",
      "required": false
    }
  ],
  "events": [
    {
      "name": "entrySelect",
      "payload": "(entry: MenuItemConfig) => boolean | void"
    },
    {
      "name": "openChange",
      "payload": "(open: boolean) => void"
    }
  ],
  "states": [
    "default",
    "open",
    "closed"
  ],
  "defaults": {
    "dimBackground": "true",
    "enableMnemonics": "true",
    "enableShortcuts": "true",
    "enableTypeAhead": "true",
    "layout": "'large'",
    "mnemonicVisible": "false"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "keys": [
      "Escape",
      "ArrowUp",
      "ArrowDown",
      "ArrowLeft",
      "ArrowRight"
    ],
    "behavior": [
      "arrow-navigation",
      "type-ahead",
      "mnemonics",
      "accelerators",
      "escape-close"
    ]
  },
  "controlled": [
    "open"
  ]
}
