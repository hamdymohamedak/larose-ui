{
  "name": "Accordion",
  "version": "1",
  "framework": "neutral",
  "purpose": "Expandable sections with single or multiple open items.",
  "composition": "Wrap each section in AccordionItem; use type multiple for FAQ layouts.",
  "interactions": [
    "Accordion",
    "AccordionItem",
    "AccordionTrigger",
    "AccordionContent"
  ],
  "props": [
    {
      "name": "collapsible",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "defaultValue",
      "type": "string[]",
      "required": false,
      "default": "[]"
    },
    {
      "name": "type",
      "type": "'single' | 'multiple'",
      "required": false,
      "default": "'single'"
    },
    {
      "name": "value",
      "type": "string[]",
      "required": false
    }
  ],
  "events": [
    {
      "name": "valueChange",
      "payload": "(value: string[]) => void"
    }
  ],
  "slots": [
    "default"
  ],
  "states": [
    "collapsed",
    "expanded"
  ],
  "defaults": {
    "collapsible": "false",
    "defaultValue": "[]",
    "type": "'single'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "keys": [
      "Enter",
      "ArrowUp",
      "ArrowDown",
      "ArrowLeft",
      "ArrowRight"
    ],
    "behavior": [
      "arrow-navigation",
      "enter-activation"
    ]
  },
  "uncontrolled": [
    "value"
  ]
}
