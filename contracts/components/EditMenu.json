{
  "name": "EditMenu",
  "version": "1",
  "framework": "neutral",
  "purpose": "EditMenu component — see composition and states for behavior.",
  "props": [
    {
      "name": "context",
      "type": "EditMenuContext",
      "required": true
    },
    {
      "name": "customActions",
      "type": "EditMenuItemConfig[]",
      "required": false,
      "default": "[]",
      "description": "Custom commands listed near related system-provided ones."
    },
    {
      "name": "dimBackground",
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    {
      "name": "includeStandardActions",
      "type": "boolean",
      "required": false,
      "default": "true",
      "description": "Include standard Cut, Copy, Paste, etc. Defaults to true."
    },
    {
      "name": "inputMode",
      "type": "EditMenuInputMode",
      "required": false,
      "default": "'auto'"
    },
    {
      "name": "longPress",
      "type": "boolean",
      "required": false,
      "default": "true",
      "description": "Touch-and-hold / long-press to reveal compact edit menu."
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false
    },
    {
      "name": "placement",
      "type": "'above' | 'below' | 'auto'",
      "required": false,
      "default": "'auto'"
    },
    {
      "name": "variant",
      "type": "EditMenuVariant",
      "required": false,
      "default": "'auto'"
    }
  ],
  "events": [
    {
      "name": "action",
      "payload": "(actionId: string) => void"
    },
    {
      "name": "openChange",
      "payload": "(open: boolean) => void"
    },
    {
      "name": "standardAction",
      "payload": "(actionId: StandardEditActionId) => void"
    }
  ],
  "states": [
    "default",
    "open",
    "closed"
  ],
  "defaults": {
    "customActions": "[]",
    "dimBackground": "true",
    "includeStandardActions": "true",
    "inputMode": "'auto'",
    "longPress": "true",
    "placement": "'auto'",
    "variant": "'auto'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  },
  "controlled": [
    "open"
  ]
}
