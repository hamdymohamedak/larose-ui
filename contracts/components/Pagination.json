{
  "name": "Pagination",
  "version": "1",
  "framework": "neutral",
  "purpose": "Pagination component — see composition and states for behavior.",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "nextLabel",
      "type": "string",
      "required": false,
      "default": "'Next page'"
    },
    {
      "name": "page",
      "type": "number",
      "required": true
    },
    {
      "name": "previousLabel",
      "type": "string",
      "required": false,
      "default": "'Previous page'"
    },
    {
      "name": "siblingCount",
      "type": "number",
      "required": false,
      "default": "1"
    },
    {
      "name": "totalPages",
      "type": "number",
      "required": true
    }
  ],
  "events": [
    {
      "name": "pageChange",
      "payload": "(page: number) => void"
    }
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "nextLabel": "'Next page'",
    "previousLabel": "'Previous page'",
    "siblingCount": "1"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
