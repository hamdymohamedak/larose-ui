{
  "name": "Textarea",
  "version": "1",
  "framework": "react",
  "props": [
    {
      "name": "error",
      "type": "string | null",
      "required": false,
      "default": "null"
    },
    {
      "name": "hint",
      "type": "string",
      "required": false
    },
    {
      "name": "inputSize",
      "type": "Size",
      "required": false,
      "default": "'md'"
    },
    {
      "name": "label",
      "type": "string",
      "required": false
    },
    {
      "name": "loading",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "required",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "state",
      "type": "UIState",
      "required": false
    }
  ],
  "events": [],
  "defaults": {
    "error": "null",
    "inputSize": "'md'",
    "loading": "false",
    "required": "false"
  },
  "keyboard": {}
}
