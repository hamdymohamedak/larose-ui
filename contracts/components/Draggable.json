{
  "name": "Draggable",
  "version": "1",
  "framework": "neutral",
  "purpose": "Draggable component — see composition and states for behavior.",
  "props": [
    {
      "name": "data",
      "type": "T",
      "required": true
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "label",
      "type": "string",
      "required": false
    },
    {
      "name": "preview",
      "type": "Node",
      "required": false
    },
    {
      "name": "sourceId",
      "type": "string",
      "required": true
    },
    {
      "name": "type",
      "type": "string",
      "required": false
    }
  ],
  "events": [],
  "states": [
    "default",
    "disabled"
  ],
  "defaults": {
    "disabled": "false"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
