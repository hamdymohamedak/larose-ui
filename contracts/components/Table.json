{
  "name": "Table",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "alternatingRows",
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    {
      "name": "caption",
      "type": "string",
      "required": false
    },
    {
      "name": "columns",
      "type": "TableColumn<T>[]",
      "required": true
    },
    {
      "name": "data",
      "type": "T[]",
      "required": true
    },
    {
      "name": "defaultSortDirection",
      "type": "SortDirection",
      "required": false,
      "default": "'asc'"
    },
    {
      "name": "defaultSortKey",
      "type": "string",
      "required": false
    },
    {
      "name": "keyExtractor",
      "type": "(row: T) => string",
      "required": true
    },
    {
      "name": "onSelectRow",
      "type": "(row: T) => void",
      "required": false
    },
    {
      "name": "resizableColumns",
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    {
      "name": "selectedKey",
      "type": "string",
      "required": false
    },
    {
      "name": "selectionMode",
      "type": "TableSelectionMode",
      "required": false,
      "default": "'none'"
    }
  ],
  "events": [
    {
      "name": "onSelectRow",
      "payload": "(row: T) => void"
    }
  ],
  "defaults": {
    "alternatingRows": "true",
    "defaultSortDirection": "'asc'",
    "resizableColumns": "true",
    "selectionMode": "'none'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
