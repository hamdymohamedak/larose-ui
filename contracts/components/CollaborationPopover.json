{
  "name": "CollaborationPopover",
  "version": "1",
  "framework": "neutral",
  "purpose": "CollaborationPopover component — see composition and states for behavior.",
  "props": [
    {
      "name": "actions",
      "type": "CollaborationAction[]",
      "required": false,
      "default": "[]"
    },
    {
      "name": "collaborators",
      "type": "Collaborator[]",
      "required": true
    },
    {
      "name": "defaultOpen",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "manageLabel",
      "type": "string",
      "required": false,
      "default": "'Manage Shared File'"
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false
    },
    {
      "name": "trigger",
      "type": "Node",
      "required": true
    }
  ],
  "events": [
    {
      "name": "manage",
      "payload": "() => void"
    },
    {
      "name": "message",
      "payload": "() => void"
    },
    {
      "name": "openChange",
      "payload": "(open: boolean) => void"
    },
    {
      "name": "video",
      "payload": "() => void"
    }
  ],
  "states": [
    "default",
    "open",
    "closed"
  ],
  "defaults": {
    "actions": "[]",
    "defaultOpen": "false",
    "manageLabel": "'Manage Shared File'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  },
  "controlled": [
    "open"
  ],
  "uncontrolled": [
    "open"
  ]
}
