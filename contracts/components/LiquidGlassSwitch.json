{
  "name": "LiquidGlassSwitch",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "activeTrackTint",
      "type": "LiquidGlassSwitchActiveTrackTint",
      "required": false,
      "default": "LIQUID_GLASS_SWITCH_ACTIVE_GREEN",
      "description": "Active track tint when on. Defaults to iOS-style green.\nPass `'glass'` () for liquid glass only, or any CSS color."
    },
    {
      "name": "borderRadius",
      "type": "number",
      "required": false,
      "default": "LIQUID_GLASS_PRESETS.switch.borderRadius"
    },
    {
      "name": "checked",
      "type": "boolean",
      "required": false
    },
    {
      "name": "defaultChecked",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "height",
      "type": "number",
      "required": false,
      "default": "32",
      "description": "Track height in px."
    },
    {
      "name": "inactiveTrackTint",
      "type": "string",
      "required": false
    },
    {
      "name": "padding",
      "type": "number",
      "required": false,
      "default": "2",
      "description": "Track padding around thumb."
    },
    {
      "name": "thumbSize",
      "type": "number",
      "required": false,
      "default": "28",
      "description": "Thumb diameter in px."
    },
    {
      "name": "thumbTint",
      "type": "string",
      "required": false
    },
    {
      "name": "width",
      "type": "number",
      "required": false,
      "default": "52",
      "description": "Track width in px."
    }
  ],
  "events": [
    {
      "name": "onChange",
      "payload": "(checked: boolean) => void"
    }
  ],
  "slots": [],
  "states": [
    "off",
    "on",
    "disabled"
  ],
  "defaults": {
    "activeTrackTint": "LIQUID_GLASS_SWITCH_ACTIVE_GREEN",
    "borderRadius": "LIQUID_GLASS_PRESETS.switch.borderRadius",
    "defaultChecked": "false",
    "disabled": "false",
    "height": "32",
    "padding": "2",
    "thumbSize": "28",
    "width": "52"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  },
  "controlled": [
    "checked"
  ],
  "uncontrolled": [
    "checked"
  ]
}
