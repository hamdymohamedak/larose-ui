{
  "name": "DocumentToolbar",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "canSave",
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    {
      "name": "newLabel",
      "type": "string",
      "required": false,
      "default": "'New'"
    },
    {
      "name": "onNew",
      "type": "() => void",
      "required": false
    },
    {
      "name": "onOpen",
      "type": "() => void",
      "required": false
    },
    {
      "name": "onSave",
      "type": "() => void",
      "required": false
    },
    {
      "name": "openLabel",
      "type": "string",
      "required": false,
      "default": "'Open'"
    },
    {
      "name": "saveLabel",
      "type": "string",
      "required": false,
      "default": "'Save'"
    },
    {
      "name": "showAddButton",
      "type": "boolean",
      "required": false,
      "default": "true"
    }
  ],
  "events": [
    {
      "name": "onNew",
      "payload": "() => void"
    },
    {
      "name": "onOpen",
      "payload": "() => void"
    },
    {
      "name": "onSave",
      "payload": "() => void"
    }
  ],
  "defaults": {
    "canSave": "true",
    "newLabel": "'New'",
    "openLabel": "'Open'",
    "saveLabel": "'Save'",
    "showAddButton": "true"
  },
  "keyboard": {}
}
