{
  "name": "DocumentToolbar",
  "version": "1",
  "framework": "neutral",
  "purpose": "DocumentToolbar component — see composition and states for behavior.",
  "props": [
    {
      "name": "canSave",
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    {
      "name": "newLabel",
      "type": "string",
      "required": false,
      "default": "'New'"
    },
    {
      "name": "openLabel",
      "type": "string",
      "required": false,
      "default": "'Open'"
    },
    {
      "name": "saveLabel",
      "type": "string",
      "required": false,
      "default": "'Save'"
    },
    {
      "name": "showAddButton",
      "type": "boolean",
      "required": false,
      "default": "true"
    }
  ],
  "events": [
    {
      "name": "new",
      "payload": "() => void"
    },
    {
      "name": "open",
      "payload": "() => void"
    },
    {
      "name": "save",
      "payload": "() => void"
    }
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "canSave": "true",
    "newLabel": "'New'",
    "openLabel": "'Open'",
    "saveLabel": "'Save'",
    "showAddButton": "true"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
