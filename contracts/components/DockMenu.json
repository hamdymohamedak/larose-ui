{
  "name": "DockMenu",
  "version": "1",
  "framework": "neutral",
  "purpose": "DockMenu component — see composition and states for behavior.",
  "props": [
    {
      "name": "appName",
      "type": "string",
      "required": true
    },
    {
      "name": "closedEntries",
      "type": "ContextMenuEntry[]",
      "required": false,
      "default": "[]",
      "description": "Actions when the app is not running (e.g. Open)."
    },
    {
      "name": "icon",
      "type": "Node",
      "required": true
    },
    {
      "name": "isRunning",
      "type": "boolean",
      "required": false,
      "default": "true",
      "description": "Whether the app is currently running (shows window list + running actions)."
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false
    },
    {
      "name": "openWindows",
      "type": "DockWindow[]",
      "required": false,
      "default": "[]"
    },
    {
      "name": "runningEntries",
      "type": "ContextMenuEntry[]",
      "required": false,
      "default": "[]",
      "description": "High-value actions when the app is running (e.g. New Window, Get New Mail)."
    }
  ],
  "events": [
    {
      "name": "entrySelect",
      "payload": "(entry: ContextMenuItemConfig) => void"
    },
    {
      "name": "openChange",
      "payload": "(open: boolean) => void"
    },
    {
      "name": "windowSelect",
      "payload": "(window: DockWindow) => void"
    }
  ],
  "states": [
    "default",
    "open",
    "closed"
  ],
  "defaults": {
    "closedEntries": "[]",
    "isRunning": "true",
    "openWindows": "[]",
    "runningEntries": "[]"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  },
  "controlled": [
    "open"
  ]
}
