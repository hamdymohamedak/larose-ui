{
  "name": "FilePreview",
  "version": "1",
  "framework": "neutral",
  "purpose": "FilePreview component — see composition and states for behavior.",
  "props": [
    {
      "name": "closeLabel",
      "type": "string",
      "required": false,
      "default": "'Close preview'"
    },
    {
      "name": "source",
      "type": "FilePreviewSource",
      "required": true
    }
  ],
  "events": [
    {
      "name": "close",
      "payload": "() => void"
    }
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "closeLabel": "'Close preview'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
