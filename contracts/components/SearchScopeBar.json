{
  "name": "SearchScopeBar",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "options",
      "type": "SearchScopeOption[]",
      "required": true
    },
    {
      "name": "value",
      "type": "string",
      "required": true
    }
  ],
  "events": [
    {
      "name": "onChange",
      "payload": "(scopeId: string) => void"
    }
  ],
  "keyboard": {},
  "controlled": [
    "value"
  ]
}
