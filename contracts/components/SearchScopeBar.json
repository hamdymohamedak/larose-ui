{
  "name": "SearchScopeBar",
  "version": "1",
  "framework": "neutral",
  "purpose": "SearchScopeBar component — see composition and states for behavior.",
  "props": [
    {
      "name": "options",
      "type": "SearchScopeOption[]",
      "required": true
    },
    {
      "name": "value",
      "type": "string",
      "required": true
    }
  ],
  "events": [
    {
      "name": "change",
      "payload": "(scopeId: string) => void"
    }
  ],
  "states": [
    "default"
  ],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  },
  "controlled": [
    "value"
  ]
}
