{
  "name": "LiquidGlassTabBar",
  "version": "1",
  "framework": "neutral",
  "purpose": "iOS-style floating tab bar with morphing selection indicator on a shared LiquidGlass track.",
  "composition": "Pass items with icons and optional labels; control activeKey for routing.",
  "interactions": [
    "LiquidGlass nav shell",
    "Selection indicator",
    "Tab buttons"
  ],
  "props": [
    {
      "name": "activeColor",
      "type": "string",
      "required": false,
      "default": "'#ffffff'"
    },
    {
      "name": "activeKey",
      "type": "string",
      "required": false
    },
    {
      "name": "borderRadius",
      "type": "number",
      "required": false,
      "default": "LIQUID_GLASS_PRESETS.tabBar.borderRadius"
    },
    {
      "name": "bottom",
      "type": "number | string",
      "required": false,
      "default": "22"
    },
    {
      "name": "defaultActiveKey",
      "type": "string",
      "required": false
    },
    {
      "name": "height",
      "type": "number",
      "required": false,
      "default": "64"
    },
    {
      "name": "inactiveColor",
      "type": "string",
      "required": false,
      "default": "'rgba(255, 255, 255, 0.55)'"
    },
    {
      "name": "indicatorBackground",
      "type": "string",
      "required": false,
      "default": "'rgba(255, 255, 255, 0.16)'"
    },
    {
      "name": "indicatorBorderColor",
      "type": "string",
      "required": false,
      "default": "'rgba(255, 255, 255, 0.28)'"
    },
    {
      "name": "indicatorPadding",
      "type": "number",
      "required": false,
      "default": "8"
    },
    {
      "name": "items",
      "type": "LiquidGlassTabItem[]",
      "required": true
    },
    {
      "name": "maxWidth",
      "type": "number",
      "required": false,
      "default": "420"
    },
    {
      "name": "position",
      "type": "'fixed' | 'absolute' | 'relative' | 'static'",
      "required": false,
      "default": "'fixed'"
    },
    {
      "name": "showIndicator",
      "type": "boolean",
      "required": false,
      "default": "true"
    }
  ],
  "events": [
    {
      "name": "change",
      "payload": "(key: string) => void"
    }
  ],
  "slots": [
    "items"
  ],
  "states": [
    "default",
    "disabled tab"
  ],
  "defaults": {
    "activeColor": "'#ffffff'",
    "borderRadius": "LIQUID_GLASS_PRESETS.tabBar.borderRadius",
    "bottom": "22",
    "height": "64",
    "inactiveColor": "'rgba(255, 255, 255, 0.55)'",
    "indicatorBackground": "'rgba(255, 255, 255, 0.16)'",
    "indicatorBorderColor": "'rgba(255, 255, 255, 0.28)'",
    "indicatorPadding": "8",
    "maxWidth": "420",
    "position": "'fixed'",
    "showIndicator": "true"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
