{
  "name": "ShareToolbar",
  "version": "1",
  "framework": "neutral",
  "purpose": "ShareToolbar component — see composition and states for behavior.",
  "props": [
    {
      "name": "collaborating",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "When true, shows the Collaboration button beside Share."
    },
    {
      "name": "collaborationActions",
      "type": "CollaborationAction[]",
      "required": false
    },
    {
      "name": "collaborators",
      "type": "Collaborator[]",
      "required": false,
      "default": "[]"
    },
    {
      "name": "destinations",
      "type": "ShareDestination[]",
      "required": false,
      "default": "defaultDestinations"
    },
    {
      "name": "manageLabel",
      "type": "string",
      "required": false
    },
    {
      "name": "permissionOptions",
      "type": "SharePermissionOption[]",
      "required": false
    },
    {
      "name": "shareSettings",
      "type": "ShareSettings",
      "required": false,
      "default": "defaultShareSettings"
    },
    {
      "name": "shareTitle",
      "type": "string",
      "required": false,
      "default": "'Share Document'",
      "description": "Document or item title shown in the share sheet."
    },
    {
      "name": "trailing",
      "type": "Node",
      "required": false
    }
  ],
  "events": [
    {
      "name": "manageSharedFile",
      "payload": "() => void"
    },
    {
      "name": "message",
      "payload": "() => void"
    },
    {
      "name": "shareSettingsChange",
      "payload": "(settings: ShareSettings) => void"
    },
    {
      "name": "video",
      "payload": "() => void"
    }
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "collaborating": "false",
    "collaborators": "[]",
    "destinations": "defaultDestinations",
    "shareSettings": "defaultShareSettings",
    "shareTitle": "'Share Document'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
