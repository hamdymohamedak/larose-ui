{
  "name": "GlassTooltip",
  "version": "1",
  "framework": "react",
  "package": "@larose-ui/glass/react",
  "props": [
    {
      "name": "content",
      "type": "ReactNode",
      "required": true
    },
    {
      "name": "children",
      "type": "ReactNode",
      "required": true
    },
    {
      "name": "portal",
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    {
      "name": "lens",
      "type": "Partial<GlassLens>",
      "required": false
    }
  ],
  "accessibility": {
    "requirements": [
      "role=tooltip with aria-describedby on hover/focus.",
      "Flips above/below based on viewport space."
    ],
    "aria": ["aria-describedby"]
  }
}
