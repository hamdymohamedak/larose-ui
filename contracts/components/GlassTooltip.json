{
  "name": "GlassTooltip",
  "version": "1",
  "framework": "react",
  "props": [
    {
      "name": "content",
      "type": "ReactNode",
      "required": true
    },
    {
      "name": "lens",
      "type": "Partial<GlassLens>",
      "required": false
    },
    {
      "name": "portal",
      "type": "boolean",
      "required": false,
      "default": "true",
      "description": "Render tooltip in a document.body portal (default true)."
    }
  ],
  "events": [],
  "defaults": {
    "portal": "true"
  },
  "package": "@larose-ui/glass/react"
}
