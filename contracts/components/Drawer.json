{
  "name": "Drawer",
  "version": "1",
  "framework": "neutral",
  "purpose": "Drawer slides in from the left or right edge with overlay dismissal.",
  "composition": "Pair with Button triggers. Configure side via defaultProps or prop.",
  "interactions": [
    "Drawer (root)",
    "Overlay",
    "Panel",
    "Header",
    "Body (default slot)"
  ],
  "props": [
    {
      "name": "closeOnOverlay",
      "type": "boolean",
      "required": false
    },
    {
      "name": "description",
      "type": "string",
      "required": false
    },
    {
      "name": "motion",
      "type": "ComponentMotionOverride",
      "required": false
    },
    {
      "name": "open",
      "type": "boolean",
      "required": true
    },
    {
      "name": "overlayClass",
      "type": "string",
      "required": false
    },
    {
      "name": "overlayStyle",
      "type": "Style",
      "required": false
    },
    {
      "name": "panelClass",
      "type": "string",
      "required": false
    },
    {
      "name": "panelStyle",
      "type": "Style",
      "required": false
    },
    {
      "name": "side",
      "type": "DrawerSide",
      "required": false
    },
    {
      "name": "title",
      "type": "string",
      "required": false
    }
  ],
  "events": [
    {
      "name": "close",
      "payload": "() => void"
    }
  ],
  "slots": [
    "default"
  ],
  "states": [
    "closed",
    "open"
  ],
  "accessibility": {
    "requirements": [
      "Focus is managed while open; Escape typically closes the overlay."
    ],
    "aria": []
  },
  "keyboard": {
    "keys": [
      "Escape"
    ],
    "behavior": [
      "escape-close",
      "focus-trap",
      "restore-focus"
    ]
  },
  "focus": [
    "trap-while-open",
    "restore-on-close"
  ],
  "motion": [
    "enter",
    "exit",
    "reduced-motion"
  ]
}
