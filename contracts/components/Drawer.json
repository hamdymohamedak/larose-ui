{
  "name": "Drawer",
  "version": "1",
  "framework": "react",
  "props": [
    {
      "name": "closeOnOverlay",
      "type": "boolean",
      "required": false
    },
    {
      "name": "description",
      "type": "string",
      "required": false
    },
    {
      "name": "motion",
      "type": "ComponentMotionOverride",
      "required": false
    },
    {
      "name": "onClose",
      "type": "() => void",
      "required": true
    },
    {
      "name": "open",
      "type": "boolean",
      "required": true
    },
    {
      "name": "overlayClassName",
      "type": "string",
      "required": false
    },
    {
      "name": "overlayStyle",
      "type": "CSSProperties",
      "required": false
    },
    {
      "name": "panelClassName",
      "type": "string",
      "required": false
    },
    {
      "name": "panelStyle",
      "type": "CSSProperties",
      "required": false
    },
    {
      "name": "side",
      "type": "DrawerSide",
      "required": false
    }
  ],
  "events": [
    {
      "name": "onClose",
      "payload": "() => void"
    }
  ],
  "slots": [
    "children"
  ],
  "states": [
    "closed",
    "open"
  ],
  "accessibility": {
    "requirements": [
      "Focus is managed while open; Escape typically closes the overlay."
    ],
    "aria": []
  },
  "keyboard": {
    "keys": [
      "Escape"
    ],
    "behavior": [
      "escape-close",
      "focus-trap"
    ]
  }
}
