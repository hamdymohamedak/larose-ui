{
  "name": "DataTable",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "caption",
      "type": "string",
      "required": false
    },
    {
      "name": "columns",
      "type": "DataTableColumn<T>[]",
      "required": true
    },
    {
      "name": "data",
      "type": "T[]",
      "required": true
    },
    {
      "name": "emptyDescription",
      "type": "string",
      "required": false
    },
    {
      "name": "emptyMessage",
      "type": "string",
      "required": false
    },
    {
      "name": "emptyTitle",
      "type": "string",
      "required": false,
      "default": "'No data'"
    },
    {
      "name": "keyExtractor",
      "type": "(row: T) => string",
      "required": true
    },
    {
      "name": "loading",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "skeletonRows",
      "type": "number",
      "required": false,
      "default": "3"
    },
    {
      "name": "striped",
      "type": "boolean",
      "required": false,
      "default": "false"
    }
  ],
  "events": [],
  "defaults": {
    "emptyTitle": "'No data'",
    "loading": "false",
    "skeletonRows": "3",
    "striped": "false"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
