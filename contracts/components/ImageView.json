{
  "name": "ImageView",
  "version": "1",
  "framework": "neutral",
  "purpose": "ImageView component — see composition and states for behavior.",
  "props": [
    {
      "name": "alt",
      "type": "string",
      "required": true
    },
    {
      "name": "background",
      "type": "ImageBackground",
      "required": false,
      "default": "'opaque'"
    },
    {
      "name": "fit",
      "type": "ImageFit",
      "required": false,
      "default": "'contain'"
    },
    {
      "name": "frameClass",
      "type": "string",
      "required": false
    },
    {
      "name": "frameStyle",
      "type": "Style",
      "required": false
    },
    {
      "name": "objectPosition",
      "type": "string",
      "required": false,
      "default": "'center'"
    },
    {
      "name": "sequence",
      "type": "ImageFrameSequence",
      "required": false,
      "description": "Animated image sequence — frames should share dimensions when possible."
    },
    {
      "name": "src",
      "type": "string",
      "required": false
    }
  ],
  "events": [],
  "states": [
    "default"
  ],
  "defaults": {
    "background": "'opaque'",
    "fit": "'contain'",
    "objectPosition": "'center'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
