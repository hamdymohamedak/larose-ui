{
  "name": "SearchTokenChip",
  "version": "1",
  "framework": "neutral",
  "purpose": "SearchTokenChip component — see composition and states for behavior.",
  "props": [
    {
      "name": "token",
      "type": "SearchToken",
      "required": true
    }
  ],
  "events": [
    {
      "name": "remove",
      "payload": "() => void"
    },
    {
      "name": "select",
      "payload": "() => void"
    }
  ],
  "states": [
    "default"
  ],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
