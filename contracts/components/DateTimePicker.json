{
  "name": "DateTimePicker",
  "version": "1",
  "framework": "neutral",
  "purpose": "DateTimePicker component — see composition and states for behavior.",
  "props": [
    {
      "name": "appearance",
      "type": "DateTimePickerStyle",
      "required": false,
      "description": "Compact / wheels / inline / automatic. Use with object `style` when you need both."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "error",
      "type": "string | null",
      "required": false,
      "default": "null"
    },
    {
      "name": "hint",
      "type": "string",
      "required": false
    },
    {
      "name": "inputSize",
      "type": "Size",
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "required": false
    },
    {
      "name": "loading",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "locale",
      "type": "string",
      "required": false,
      "default": "'en'"
    },
    {
      "name": "maxDate",
      "type": "string",
      "required": false
    },
    {
      "name": "minDate",
      "type": "string",
      "required": false
    },
    {
      "name": "minuteInterval",
      "type": "number",
      "required": false,
      "default": "1"
    },
    {
      "name": "mode",
      "type": "DateTimePickerMode",
      "required": false,
      "default": "'date'"
    },
    {
      "name": "state",
      "type": "UIState",
      "required": false
    },
    {
      "name": "use12Hour",
      "type": "boolean",
      "required": false,
      "default": "locale.startsWith('en')"
    },
    {
      "name": "value",
      "type": "DateTimeValue",
      "required": false,
      "default": "{}"
    },
    {
      "name": "yearRange",
      "type": "{ start: number; end: number }",
      "required": false,
      "default": "{ start: new Date().getFullYear() - 5, end: new Date().getFullYear() + 5 }"
    }
  ],
  "events": [
    {
      "name": "change",
      "payload": "(value: DateTimeValue) => void"
    }
  ],
  "states": [
    "default",
    "disabled",
    "loading",
    "error"
  ],
  "defaults": {
    "disabled": "false",
    "error": "null",
    "loading": "false",
    "locale": "'en'",
    "minuteInterval": "1",
    "mode": "'date'",
    "use12Hour": "locale.startsWith('en')",
    "value": "{}",
    "yearRange": "{ start: new Date().getFullYear() - 5, end: new Date().getFullYear() + 5 }"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  },
  "controlled": [
    "value"
  ]
}
