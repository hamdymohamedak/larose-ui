{
  "name": "MenuBarExtra",
  "version": "1",
  "framework": "neutral",
  "purpose": "MenuBarExtra component — see composition and states for behavior.",
  "props": [
    {
      "name": "enableMnemonics",
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    {
      "name": "enableTypeAhead",
      "type": "boolean",
      "required": false,
      "default": "true"
    },
    {
      "name": "isOpen",
      "type": "boolean",
      "required": true
    },
    {
      "name": "mnemonicVisible",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "optionKey",
      "type": "boolean",
      "required": true
    }
  ],
  "events": [
    {
      "name": "action",
      "payload": "(entry: MenuItemConfig) => void"
    },
    {
      "name": "openChange",
      "payload": "(open: boolean) => void"
    }
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "enableMnemonics": "true",
    "enableTypeAhead": "true",
    "mnemonicVisible": "false"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Keyboard accessible; disabled and loading states must be announced."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "type-ahead",
      "mnemonics"
    ]
  }
}
