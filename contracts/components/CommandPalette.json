{
  "name": "CommandPalette",
  "version": "1",
  "framework": "neutral",
  "purpose": "CommandPalette offers searchable command discovery with keyboard navigation.",
  "composition": "Register commands with labels and onSelect handlers.",
  "interactions": [
    "CommandPalette",
    "Search input",
    "Results groups",
    "Items"
  ],
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "emptyMessage",
      "type": "string",
      "required": false,
      "default": "'No commands found'"
    },
    {
      "name": "items",
      "type": "CommandPaletteItem[]",
      "required": true
    },
    {
      "name": "open",
      "type": "boolean",
      "required": true
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "default": "'Search commands…'"
    }
  ],
  "events": [
    {
      "name": "openChange",
      "payload": "(open: boolean) => void"
    }
  ],
  "slots": [
    "commands"
  ],
  "states": [
    "closed",
    "open"
  ],
  "defaults": {
    "emptyMessage": "'No commands found'",
    "placeholder": "'Search commands…'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Focus is managed while open; Escape typically closes the overlay."
    ],
    "aria": []
  },
  "keyboard": {
    "keys": [
      "Escape",
      "Enter",
      "ArrowUp",
      "ArrowDown",
      "ArrowLeft",
      "ArrowRight"
    ],
    "behavior": [
      "arrow-navigation",
      "type-ahead",
      "escape-close",
      "enter-activation"
    ]
  },
  "controlled": [
    "open"
  ]
}
