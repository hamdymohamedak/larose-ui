{
  "name": "Skeleton",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "height",
      "type": "string | number",
      "required": false,
      "default": "'1rem'"
    },
    {
      "name": "lines",
      "type": "number",
      "required": false,
      "default": "1"
    },
    {
      "name": "variant",
      "type": "'text' | 'circular' | 'rectangular'",
      "required": false,
      "default": "'text'"
    },
    {
      "name": "width",
      "type": "string | number",
      "required": false,
      "default": "'100%'"
    }
  ],
  "events": [],
  "defaults": {
    "height": "'1rem'",
    "lines": "1",
    "variant": "'text'",
    "width": "'100%'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
