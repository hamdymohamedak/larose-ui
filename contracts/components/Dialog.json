{
  "name": "Dialog",
  "version": "1",
  "framework": "neutral",
  "purpose": "Dialog is a lightweight modal surface for confirmations and forms.",
  "composition": "Use for focused tasks smaller than full Modal layouts. Confirm visibility defaults to shown (showConfirm).",
  "interactions": [
    "Dialog",
    "Header",
    "Title",
    "Description",
    "Actions"
  ],
  "props": [
    {
      "name": "cancelLabel",
      "type": "string",
      "required": false,
      "default": "'Cancel'"
    },
    {
      "name": "confirmLabel",
      "type": "string",
      "required": false,
      "default": "'Confirm'"
    },
    {
      "name": "description",
      "type": "string",
      "required": false
    },
    {
      "name": "loading",
      "type": "boolean",
      "required": false
    },
    {
      "name": "open",
      "type": "boolean",
      "required": true
    },
    {
      "name": "showConfirm",
      "type": "boolean",
      "required": false,
      "description": "When false, hide the confirm button. Default true (matches Vue/Svelte)."
    },
    {
      "name": "title",
      "type": "string",
      "required": true
    },
    {
      "name": "variant",
      "type": "'default' | 'destructive'",
      "required": false,
      "default": "'default'"
    }
  ],
  "events": [
    {
      "name": "close",
      "payload": "() => void"
    },
    {
      "name": "confirm",
      "payload": "() => void"
    }
  ],
  "slots": [
    "default"
  ],
  "states": [
    "closed",
    "open"
  ],
  "defaults": {
    "cancelLabel": "'Cancel'",
    "confirmLabel": "'Confirm'",
    "variant": "'default'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props.",
      "Focus is managed while open; Escape typically closes the overlay."
    ],
    "aria": []
  },
  "keyboard": {
    "keys": [
      "Escape"
    ],
    "behavior": [
      "escape-close",
      "focus-trap",
      "restore-focus"
    ]
  },
  "focus": [
    "trap-while-open",
    "restore-on-close"
  ],
  "motion": [
    "enter",
    "exit",
    "reduced-motion"
  ]
}
