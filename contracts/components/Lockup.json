{
  "name": "Lockup",
  "version": "1",
  "framework": "neutral",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "axis",
      "type": "LockupAxis",
      "required": false
    },
    {
      "name": "focused",
      "type": "boolean",
      "required": false
    },
    {
      "name": "footer",
      "type": "Node",
      "required": false
    },
    {
      "name": "header",
      "type": "Node",
      "required": false
    }
  ],
  "events": [
    {
      "name": "onBlur",
      "payload": "() => void"
    },
    {
      "name": "onClick",
      "payload": "() => void"
    },
    {
      "name": "onFocus",
      "payload": "() => void"
    }
  ],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
