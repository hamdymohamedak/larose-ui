{
  "name": "WheelColumn",
  "version": "1",
  "framework": "neutral",
  "purpose": "WheelColumn component — see composition and states for behavior.",
  "props": [
    {
      "name": "columnFlex",
      "type": "number",
      "required": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false"
    },
    {
      "name": "label",
      "type": "string",
      "required": false
    },
    {
      "name": "options",
      "type": "PickerOption[]",
      "required": true
    },
    {
      "name": "value",
      "type": "string",
      "required": true
    }
  ],
  "events": [
    {
      "name": "change",
      "payload": "(value: string) => void"
    }
  ],
  "states": [
    "default",
    "disabled"
  ],
  "defaults": {
    "disabled": "false"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  },
  "controlled": [
    "value"
  ]
}
