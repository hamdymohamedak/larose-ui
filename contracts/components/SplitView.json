{
  "name": "SplitView",
  "version": "1",
  "framework": "neutral",
  "purpose": "SplitView component — see composition and states for behavior.",
  "props": [
    {
      "name": "'aria-label'",
      "type": "string",
      "required": false
    },
    {
      "name": "compactMode",
      "type": "SplitCompactMode",
      "required": false,
      "default": "'side-by-side'"
    },
    {
      "name": "orientation",
      "type": "SplitOrientation",
      "required": false,
      "default": "'horizontal'"
    },
    {
      "name": "storageKey",
      "type": "string",
      "required": false
    },
    {
      "name": "toolbar",
      "type": "Node",
      "required": false
    }
  ],
  "events": [
    {
      "name": "sizesChange",
      "payload": "(sizes: number[]) => void"
    }
  ],
  "states": [
    "default"
  ],
  "defaults": {
    "compactMode": "'side-by-side'",
    "orientation": "'horizontal'"
  },
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "keyboard-accessible"
    ]
  }
}
