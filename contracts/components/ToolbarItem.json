{
  "name": "ToolbarItem",
  "version": "1",
  "framework": "neutral",
  "purpose": "ToolbarItem component — see composition and states for behavior.",
  "props": [
    {
      "name": "collapsible",
      "type": "boolean",
      "required": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false
    },
    {
      "name": "icon",
      "type": "Node",
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "required": true
    },
    {
      "name": "prominent",
      "type": "boolean",
      "required": false
    },
    {
      "name": "showLabel",
      "type": "boolean",
      "required": false
    }
  ],
  "events": [
    {
      "name": "click",
      "payload": "() => void"
    }
  ],
  "states": [
    "default",
    "disabled"
  ],
  "accessibility": {
    "requirements": [
      "Supports ARIA attributes via standard HTML element props."
    ],
    "aria": []
  },
  "keyboard": {
    "behavior": [
      "not-focusable"
    ]
  }
}
